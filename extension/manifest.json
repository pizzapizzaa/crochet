{
  "manifest_version": 3,
  "name": "ZippyZack Importer",
  "version": "1.0.0",
  "description": "Import a product from any shop page, or a board of pins from Pinterest, straight into your ZippyZack POS.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import into ZippyZack"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
