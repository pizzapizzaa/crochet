---
// Rendered per request so a product published from /pos is live immediately,
// with no rebuild in between.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProductBySlug, getProducts } from '../../lib/catalog';
import { getMakesUsingProduct, kitHref } from '../../lib/makes';
import { ON_IMG_ERROR, productImage } from '../../lib/images';
import { SHOP_HOME, SHOW_MATERIALS_PAGE } from '../../lib/shop';

const { slug } = Astro.params;

const product = await getProductBySlug(slug!);

if (!product) {
  return Astro.redirect(SHOW_MATERIALS_PAGE ? '/store' : SHOP_HOME);
}

/*
 * The shop sells kits, not loose items, so this page is information: what the
 * thing is, and the makes and bundles it comes in — which is where it can be
 * bought.
 */
const usedIn = await getMakesUsingProduct(product.id);

// With the Materials pages hidden, an old link to a product lands on a kit
// that contains it, which is the page where it can actually be bought.
if (!SHOW_MATERIALS_PAGE) {
  return Astro.redirect(usedIn[0] ? kitHref(usedIn[0]) : SHOP_HOME);
}

// Related products (same category, exclude self)
const related = (await getProducts())
  .filter((p) => p.id !== product.id && p.category === product.category)
  .slice(0, 3);

const primaryImage = productImage(product.images?.[0]);
---

<Layout
  title={product.name}
  description={product.description}
  image={primaryImage}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="text-xs text-brown-light mb-8 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-rose-dust transition-colors">Home</a>
      <span>/</span>
      <a href="/store" class="hover:text-rose-dust transition-colors">Materials</a>
      <span>/</span>
      <a
        href={`/store?category=${encodeURIComponent(product.category)}`}
        class="hover:text-rose-dust transition-colors"
      >
        {product.category}
      </a>
      <span>/</span>
      <span class="text-brown-warm">{product.name}</span>
    </nav>

    <!-- Product layout -->
    <div class="grid lg:grid-cols-2 gap-14">
      <!-- Images -->
      <div class="space-y-4">
        <!--
          No fixed ratio here: a product photo is evidence, and cropping it to
          a square hides whatever sat at the top and bottom of the frame. It is
          capped at 70vh so a tall portrait shot cannot push the kits it comes in
          below the fold. The thumbnails below stay square — a tidy
          strip is worth a crop, the photo being examined is not.
        -->
        <div class="relative flex items-center justify-center overflow-hidden rounded-3xl bg-cream-200 shadow-xl">
          <img
            id="product-image"
            src={primaryImage}
            onerror={ON_IMG_ERROR}
            alt={product.name}
            class="block h-auto max-h-[70vh] w-auto max-w-full"
          />
        </div>
        <!-- Thumbnail strip (if multiple images) -->
        {
          product.images.length > 1 && (
            <div class="grid grid-cols-4 gap-3">
              {product.images.map((img, i) => (
                <button
                  type="button"
                  data-thumb
                  data-image={img}
                  data-alt={`${product.name} view ${i + 1}`}
                  aria-label={`Show image ${i + 1} of ${product.images.length}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                  class={`block aspect-square w-full overflow-hidden rounded-xl ring-2 transition-all hover:ring-rose-dust/60 ${
                    i === 0 ? 'ring-rose-dust' : 'ring-transparent'
                  }`}
                >
                  <img
                    src={img}
                    onerror={ON_IMG_ERROR}
                    alt=""
                    class="h-full w-full object-cover"
                  />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- Details -->
      <div class="flex flex-col">
        <span class="text-sage text-xs font-semibold tracking-widest uppercase">
          {product.category}
        </span>
        <h1 class="font-display text-4xl font-semibold text-brown-dark mt-2 leading-tight">
          {product.name}
        </h1>

        <p class="mt-3 inline-flex items-center gap-2 self-start rounded-full bg-cream-100 px-3 py-1.5 text-xs font-medium text-brown-warm">
          Comes in our kits, not sold on its own
        </p>

        <hr class="border-cream-300 my-6" />

        <!-- Description -->
        <p class="text-brown-warm leading-relaxed">{product.description}</p>

        <!-- Details list -->
        <div class="mt-6 grid grid-cols-2 gap-3">
          {
            [
              { label: 'Yarn Weight', value: product.yarn_weight },
              { label: 'Hook Size', value: product.hook_size },
              { label: 'Dimensions', value: product.dimensions },
              { label: 'Care', value: product.care_instructions },
            ]
              .filter((d) => d.value)
              .map((detail) => (
                <div class="bg-cream-100 rounded-xl px-4 py-3">
                  <p class="text-xs text-brown-light font-medium uppercase tracking-wide">
                    {detail.label}
                  </p>
                  <p class="text-sm text-brown-dark mt-0.5">{detail.value}</p>
                </div>
              ))
          }
        </div>

        <!-- Where it can be bought: the kits it comes in -->
        <div class="mt-6 rounded-2xl border border-cream-300 bg-cream-50 p-4">
          <p class="text-xs font-bold uppercase tracking-widest text-brown-light">
            {usedIn.length === 0 ? 'Not in a kit yet' : usedIn.length === 1 ? 'Comes in this kit' : 'Comes in these kits'}
          </p>
          {
            usedIn.length > 0 ? (
              <ul class="mt-2.5 space-y-1.5">
                {usedIn.map((m) => (
                  <li>
                    <a
                      href={kitHref(m)}
                      class="flex items-center gap-2 text-sm font-semibold text-brown-dark transition-colors hover:text-rose-dust"
                    >
                      <span class="text-rose-dust">→</span>
                      {m.title}
                      <span class="text-xs font-normal text-brown-light">{m.kind === 'bundle' ? 'Bundle' : 'Make'}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-1.5 text-sm text-brown-warm">
                We sell yarn and tools as kits. Have a look at our bundles, or ask us about this one.
              </p>
            )
          }
        </div>

        <!-- Tags -->
        {
          product.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {product.tags.map((tag) => (
                <a
                  href={`/store?q=${tag}`}
                  class="text-xs bg-cream-200 hover:bg-rose-dust/10 hover:text-rose-dust text-brown-light px-3 py-1.5 rounded-full transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }

        <hr class="border-cream-300 my-6" />

        <!-- CTA -->
        <div class="space-y-3">
          <a
            href="/bundles"
            class="block w-full rounded-full bg-btn-gradient py-4 text-center text-sm font-semibold text-ink transition-colors duration-200 hover:brightness-105"
          >
            Browse the bundles
          </a>
          <a
            href="/contact"
            class="w-full py-4 rounded-full font-medium text-sm text-center border border-brown-light/40 hover:border-rose-dust hover:text-rose-dust text-brown-warm transition-all block"
          >
            Message Me About This Item
          </a>
        </div>

        <!-- Shipping note -->
        <div class="mt-6 bg-sage/10 rounded-2xl px-5 py-4 flex items-start gap-3">
          <svg
            class="w-5 h-5 text-sage shrink-0 mt-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            />
          </svg>
          <div>
            <p class="text-sm font-medium text-brown-dark">Free shipping on orders over $80</p>
            <p class="text-xs text-brown-light mt-0.5">
              Handmade with care · Ships in 3–5 business days
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {
      related.length > 0 && (
        <section class="mt-24">
          <div class="flex items-end justify-between mb-10">
            <div>
              <span class="text-rose-dust text-xs font-semibold tracking-widest uppercase">
                You might also like
              </span>
              <h2 class="font-display text-3xl font-semibold text-brown-dark mt-1">
                More from {product.category}
              </h2>
            </div>
            <a
              href={`/store?category=${encodeURIComponent(product.category)}`}
              class="text-brown-warm hover:text-rose-dust text-sm font-medium transition-colors hidden sm:block"
            >
              View all →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<script>
  /*
   * Thumbnail strip. The markup shipped without this, so clicking a thumbnail
   * did nothing at all — swapping the src is the whole job.
   */
  const main = document.getElementById('product-image') as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-thumb]'));

  function show(button: HTMLButtonElement) {
    const src = button.dataset.image;
    if (!main || !src) return;

    main.src = src;
    main.alt = button.dataset.alt ?? '';

    for (const thumb of thumbs) {
      const active = thumb === button;
      thumb.classList.toggle('ring-rose-dust', active);
      thumb.classList.toggle('ring-transparent', !active);
      thumb.setAttribute('aria-current', active ? 'true' : 'false');
    }
  }

  for (const thumb of thumbs) {
    thumb.addEventListener('click', () => show(thumb));
  }

</script>
