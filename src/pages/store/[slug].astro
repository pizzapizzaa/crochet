---
// Rendered per request so a product published from /pos is live immediately,
// with no rebuild in between.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProductBySlug, getProducts } from '../../lib/catalog';

const { slug } = Astro.params;

const product = await getProductBySlug(slug!);

if (!product) {
  return Astro.redirect('/store');
}

// Related products (same category, exclude self)
const related = (await getProducts())
  .filter((p) => p.id !== product.id && p.category === product.category)
  .slice(0, 3);

const primaryImage = product.images?.[0] ?? '/placeholder-product.jpg';
const discount = product.compare_at_price
  ? Math.round(((product.compare_at_price - product.price) / product.compare_at_price) * 100)
  : null;
const isSoldOut = product.stock === 0;
const isLowStock = product.stock > 0 && product.stock <= 3;
const inStock = product.stock > 3;
---

<Layout
  title={product.name}
  description={product.description}
  image={primaryImage}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="text-xs text-brown-light mb-8 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-rose-dust transition-colors">Home</a>
      <span>/</span>
      <a href="/store" class="hover:text-rose-dust transition-colors">Shop</a>
      <span>/</span>
      <a
        href={`/store?category=${encodeURIComponent(product.category)}`}
        class="hover:text-rose-dust transition-colors"
      >
        {product.category}
      </a>
      <span>/</span>
      <span class="text-brown-warm">{product.name}</span>
    </nav>

    <!-- Product layout -->
    <div class="grid lg:grid-cols-2 gap-14">
      <!-- Images -->
      <div class="space-y-4">
        <div class="rounded-3xl overflow-hidden aspect-square shadow-xl relative bg-cream-200">
          <img
            src={primaryImage}
            alt={product.name}
            class="w-full h-full object-cover"
          />
          {
            discount && (
              <span class="absolute top-5 left-5 bg-rose-dust text-white text-sm font-semibold px-3 py-1.5 rounded-full">
                -{discount}% off
              </span>
            )
          }
          {isSoldOut && (
            <div class="absolute inset-0 bg-brown-dark/30 flex items-center justify-center rounded-3xl">
              <span class="bg-white text-brown-dark font-semibold px-6 py-2 rounded-full">
                Sold Out
              </span>
            </div>
          )}
        </div>
        <!-- Thumbnail strip (if multiple images) -->
        {
          product.images.length > 1 && (
            <div class="grid grid-cols-4 gap-3">
              {product.images.map((img, i) => (
                <div class="rounded-xl overflow-hidden aspect-square cursor-pointer ring-2 ring-transparent hover:ring-rose-dust transition-all">
                  <img src={img} alt={`${product.name} view ${i + 1}`} class="w-full h-full object-cover" />
                </div>
              ))}
            </div>
          )
        }
      </div>

      <!-- Details -->
      <div class="flex flex-col">
        <span class="text-sage text-xs font-semibold tracking-widest uppercase">
          {product.category}
        </span>
        <h1 class="font-display text-4xl font-semibold text-brown-dark mt-2 leading-tight">
          {product.name}
        </h1>

        <!-- Price -->
        <div class="flex items-baseline gap-3 mt-4">
          <span class="text-3xl font-bold text-brown-dark">${product.price.toFixed(2)}</span>
          {
            product.compare_at_price && (
              <span class="text-brown-light text-lg line-through">
                ${product.compare_at_price.toFixed(2)}
              </span>
            )
          }
          {
            discount && (
              <span class="text-rose-dust text-sm font-semibold">Save {discount}%</span>
            )
          }
        </div>

        <!-- Stock badge -->
        <div class="mt-3 flex items-center gap-2">
          {isSoldOut && (
            <span class="inline-flex items-center gap-1.5 text-sm text-red-500 font-medium">
              <span class="w-2 h-2 rounded-full bg-red-500 inline-block" />
              Out of Stock
            </span>
          )}
          {isLowStock && (
            <span class="inline-flex items-center gap-1.5 text-sm text-amber-600 font-medium">
              <span class="w-2 h-2 rounded-full bg-amber-500 inline-block" />
              Only {product.stock} left — order soon
            </span>
          )}
          {inStock && (
            <span class="inline-flex items-center gap-1.5 text-sm text-sage font-medium">
              <span class="w-2 h-2 rounded-full bg-sage inline-block" />
              In Stock
            </span>
          )}
        </div>

        <hr class="border-cream-300 my-6" />

        <!-- Description -->
        <p class="text-brown-warm leading-relaxed">{product.description}</p>

        <!-- Details list -->
        <div class="mt-6 grid grid-cols-2 gap-3">
          {
            [
              { label: 'Yarn Weight', value: product.yarn_weight },
              { label: 'Hook Size', value: product.hook_size },
              { label: 'Dimensions', value: product.dimensions },
              { label: 'Care', value: product.care_instructions },
            ]
              .filter((d) => d.value)
              .map((detail) => (
                <div class="bg-cream-100 rounded-xl px-4 py-3">
                  <p class="text-xs text-brown-light font-medium uppercase tracking-wide">
                    {detail.label}
                  </p>
                  <p class="text-sm text-brown-dark mt-0.5">{detail.value}</p>
                </div>
              ))
          }
        </div>

        <!-- Tags -->
        {
          product.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {product.tags.map((tag) => (
                <a
                  href={`/store?q=${tag}`}
                  class="text-xs bg-cream-200 hover:bg-rose-dust/10 hover:text-rose-dust text-brown-light px-3 py-1.5 rounded-full transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }

        <hr class="border-cream-300 my-6" />

        <!-- CTA -->
        <div class="space-y-3">
          <button
            class={`w-full py-4 rounded-full font-semibold text-sm transition-colors duration-200 ${
              isSoldOut
                ? 'bg-cream-200 text-brown-light cursor-not-allowed'
                : 'bg-btn-gradient text-ink hover:brightness-105'
            }`}
            disabled={isSoldOut}
          >
            {isSoldOut ? 'Sold Out' : 'Add to Cart — $' + product.price.toFixed(2)}
          </button>
          <a
            href="/contact"
            class="w-full py-4 rounded-full font-medium text-sm text-center border border-brown-light/40 hover:border-rose-dust hover:text-rose-dust text-brown-warm transition-all block"
          >
            Message Me About This Item
          </a>
        </div>

        <!-- Shipping note -->
        <div class="mt-6 bg-sage/10 rounded-2xl px-5 py-4 flex items-start gap-3">
          <svg
            class="w-5 h-5 text-sage shrink-0 mt-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            />
          </svg>
          <div>
            <p class="text-sm font-medium text-brown-dark">Free shipping on orders over $80</p>
            <p class="text-xs text-brown-light mt-0.5">
              Handmade with care · Ships in 3–5 business days
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {
      related.length > 0 && (
        <section class="mt-24">
          <div class="flex items-end justify-between mb-10">
            <div>
              <span class="text-rose-dust text-xs font-semibold tracking-widest uppercase">
                You might also like
              </span>
              <h2 class="font-display text-3xl font-semibold text-brown-dark mt-1">
                More from {product.category}
              </h2>
            </div>
            <a
              href={`/store?category=${encodeURIComponent(product.category)}`}
              class="text-brown-warm hover:text-rose-dust text-sm font-medium transition-colors hidden sm:block"
            >
              View all →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>
