---
// Rendered per request so a make published from /pos is live immediately.
export const prerender = false;

import KitPage from '../../components/KitPage.astro';
import { getMakeBySlug, getMakes } from '../../lib/makes';

const { slug } = Astro.params;

const make = await getMakeBySlug(slug!, 'make');
if (!make) {
  return Astro.redirect('/makes');
}

const related = (await getMakes()).filter((m) => m.id !== make.id).slice(0, 3);
---

<KitPage make={make} related={related} />
