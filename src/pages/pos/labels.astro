---
export const prerender = false;

import PosLayout from '../../layouts/PosLayout.astro';
import { isAuthed, loginUrl } from '../../lib/auth';
import { getSupabaseAdmin } from '../../lib/supabaseAdmin';
import { withResolvedItems } from '../../lib/makes';
import {
  COLOURWAYS,
  DEFAULT_ROUND_MESSAGE,
  DEFAULT_TAGLINE,
  DPI_CHOICES,
  ROUND_LABEL_MM,
  SQUARE_LABEL_MM,
} from '../../lib/labels';

/*
 * Sticker labels for the packaging.
 *
 * Two fixed formats — a 7 cm round thank-you sticker and a 12 cm square
 * bundle label — drawn in the browser by src/lib/labels.ts and downloaded as
 * SVG or PNG. Nothing is saved server-side: the form lives in localStorage,
 * so the last label is still there next time.
 *
 * The only thing read from Supabase is the bundle list, to fill the square
 * label's name and contents in one go. If that fails the form still works;
 * it just has to be typed.
 */

if (!isAuthed(Astro.cookies)) {
  return Astro.redirect(loginUrl(Astro.url));
}

interface BundleOption {
  id: string;
  title: string;
  items: string[];
}

let bundles: BundleOption[] = [];
const admin = getSupabaseAdmin();
if (admin) {
  const { data } = await admin
    .from('makes')
    .select('*, items:make_items(*, product:products(*))')
    .order('display_order', { ascending: true })
    .order('created_at', { ascending: false });

  bundles = ((data ?? []) as unknown as Record<string, unknown>[])
    .map(withResolvedItems)
    .filter((make) => make.kind === 'bundle')
    .map((make) => ({
      id: make.id,
      title: make.title,
      items: make.items.map((item) => `${item.quantity} × ${item.product.name}`),
    }));
}

// "<" is escaped so a product name can never close the script tag.
const bundlesJson = JSON.stringify(bundles).replace(/</g, '\\u003c');

const field =
  'w-full rounded-field border border-cream-300 bg-cream-50 px-3 py-2 text-sm text-ink placeholder-ink-faint focus:border-mint-mid focus:outline-none focus:ring-2 focus:ring-mint/40';
const label = 'mb-1.5 block text-micro font-bold uppercase tracking-eyebrow text-ink-muted';
const hint = 'mt-1 text-xs text-ink-muted';
const tab =
  'label-tab flex-1 rounded-pill px-4 py-2 text-sm font-bold text-ink-muted transition-colors duration-fast ease-out hover:text-ink aria-selected:bg-paper aria-selected:text-ink aria-selected:shadow-sm';
---

<PosLayout title="Labels" section="labels">
  <header class="mb-6">
    <p class="text-micro font-bold uppercase tracking-eyebrow text-ink-muted">Packaging</p>
    <h1 class="mt-1 font-display text-3xl font-extrabold text-ink sm:text-4xl">Labels</h1>
    <p class="mt-1.5 text-sm text-ink-muted">
      Stickers for the parcel, ready for the print shop. Text is converted to outlines, so the files
      print the same anywhere — no fonts to send along.
    </p>
  </header>

  <div class="grid gap-5 lg:grid-cols-5">
    <!-- Form -->
    <form id="label-form" class="space-y-5 lg:col-span-2" autocomplete="off">
      <div class="flex gap-1 rounded-pill bg-cream-200 p-1" role="tablist" aria-label="Label type">
        <button type="button" role="tab" data-kind="round" aria-selected="true" class={tab}>
          Round · {ROUND_LABEL_MM / 10} cm
        </button>
        <button type="button" role="tab" data-kind="square" aria-selected="false" class={tab}>
          Square · {SQUARE_LABEL_MM / 10} cm
        </button>
      </div>

      <div class="rounded-card border border-cream-300 bg-paper p-5 shadow-sm">
        <!-- Round -->
        <div data-panel="round" class="space-y-4">
          <h2 class="font-display text-lg font-bold text-ink">Thank-you sticker</h2>
          <div>
            <label class={label} for="round-message">Message</label>
            <input id="round-message" name="roundMessage" type="text" maxlength="80" value={DEFAULT_ROUND_MESSAGE} class={field} />
            <p class={hint}>Arched over the logo.</p>
          </div>
          <div>
            <label class={label} for="round-tagline">Bottom text</label>
            <input id="round-tagline" name="roundTagline" type="text" maxlength="40" value={DEFAULT_TAGLINE} class={field} />
            <p class={hint}>Arched under it, in capitals. Leave empty for none.</p>
          </div>
        </div>

        <!-- Square -->
        <div data-panel="square" class="space-y-4" hidden>
          <h2 class="font-display text-lg font-bold text-ink">Bundle label</h2>
          {
            bundles.length > 0 && (
              <div>
                <label class={label} for="square-source">
                  Fill from a bundle
                </label>
                <select id="square-source" class={field}>
                  <option value="">Choose a bundle…</option>
                  {bundles.map((bundle) => (
                    <option value={bundle.id}>{bundle.title}</option>
                  ))}
                </select>
                <p class={hint}>Copies its name and contents in below, for you to edit.</p>
              </div>
            )
          }
          <div>
            <label class={label} for="square-name">Bundle name</label>
            <input id="square-name" name="squareName" type="text" maxlength="80" placeholder="Bundle for beginners" class={field} />
          </div>
          <div>
            <label class={label} for="square-items">Items</label>
            <textarea id="square-items" name="squareItems" rows="7" placeholder={'2 × Cotton yarn, 50 g\n1 × Bamboo hook, 4 mm\n6 × Stitch markers'} class={field}></textarea>
            <p class={hint}>One per line. The type shrinks, then splits into two columns, to fit.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-5">
            <div class="sm:col-span-2">
              <label class={label} for="square-weight">Total weight</label>
              <input id="square-weight" name="squareWeight" type="text" maxlength="24" placeholder="320 g" class={field} />
            </div>
            <div class="sm:col-span-3">
              <label class={label} for="square-material">Material</label>
              <input id="square-material" name="squareMaterial" type="text" maxlength="120" placeholder="100% cotton yarn, bamboo" class={field} />
            </div>
          </div>
        </div>
      </div>

      <!-- Shared options -->
      <div class="space-y-4 rounded-card border border-cream-300 bg-paper p-5 shadow-sm">
        <div>
          <span class={label}>Colour</span>
          <div class="flex flex-wrap gap-2">
            {
              Object.entries(COLOURWAYS).map(([key, colourway], i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="colourway" value={key} checked={i === 0} class="peer sr-only" />
                  <span class="flex items-center gap-2 rounded-pill border border-cream-300 bg-cream-50 py-1.5 pl-1.5 pr-3 text-xs font-bold text-ink-muted transition-colors duration-fast ease-out peer-checked:border-mint-deep peer-checked:bg-mint-wash peer-checked:text-ink peer-focus-visible:ring-2 peer-focus-visible:ring-mint/40">
                    <span class="h-5 w-5 rounded-full border border-cream-400" style={`background:${colourway.bg}`} />
                    {colourway.label}
                  </span>
                </label>
              ))
            }
          </div>
        </div>

        <label class="flex cursor-pointer items-start gap-2.5 rounded-field bg-cream-50 p-3">
          <input type="checkbox" name="bleed" class="mt-0.5 h-4 w-4 shrink-0 accent-[#00695C]" />
          <span>
            <span class="block text-sm font-bold text-ink">Add 2 mm bleed</span>
            <span class="block text-xs text-ink-muted">
              Carries the background past the cut line on every side. Turn on if your printer asks for bleed.
            </span>
          </span>
        </label>
      </div>
    </form>

    <!-- Preview + downloads -->
    <div class="lg:col-span-3">
      <div class="sticky top-6 rounded-card border border-cream-300 bg-paper p-5 shadow-sm">
        <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-display text-lg font-bold text-ink">Preview</h2>
          <p id="label-size" class="text-xs font-semibold text-ink-muted"></p>
        </div>

        <div class="flex items-center justify-center rounded-field bg-cream-200 p-6 sm:p-10">
          <div
            id="label-preview"
            class="w-full max-w-md [&>svg]:block [&>svg]:h-auto [&>svg]:w-full [&>svg]:drop-shadow-md"
            aria-live="polite"
          >
            <p class="py-24 text-center text-sm text-ink-muted">Loading the brand fonts…</p>
          </div>
        </div>

        <ul id="label-warnings" class="mt-4 space-y-1.5 rounded-card border border-lemon-soft bg-lemon-wash px-4 py-3 text-sm font-semibold text-lemon-deep" hidden></ul>

        <div class="mt-5 flex flex-wrap items-end gap-3 border-t border-cream-300 pt-5">
          <button
            type="button"
            id="download-svg"
            disabled
            class="rounded-pill border border-mint-deep px-5 py-2.5 text-sm font-bold text-mint-deep transition-colors duration-fast ease-out hover:bg-mint-wash disabled:cursor-not-allowed disabled:opacity-50"
          >
            Download SVG
          </button>
          <button
            type="button"
            id="download-png"
            disabled
            class="rounded-pill bg-btn-gradient px-6 py-2.5 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105 active:scale-[.98] disabled:cursor-not-allowed disabled:opacity-50"
          >
            Download PNG
          </button>
          <div>
            <label class={label} for="label-dpi">PNG resolution</label>
            <select id="label-dpi" name="dpi" form="label-form" class={`${field} w-auto`}>
              {DPI_CHOICES.map((dpi) => <option value={dpi} selected={dpi === 600}>{dpi} dpi</option>)}
            </select>
          </div>
        </div>
        <p class="mt-3 text-xs text-ink-muted">
          SVG is vector and scales to any size. PNG has a transparent background outside the round sticker
          and carries its print size, so it opens at the right dimensions.
        </p>
      </div>
    </div>
  </div>

  <script type="application/json" id="label-bundles" set:html={bundlesJson} />
</PosLayout>

<script>
  import { parse } from 'opentype.js';
  import {
    buildRoundLabel,
    buildSquareLabel,
    isColourway,
    LABEL_FONT_FILES,
    labelSlug,
    mmToPx,
    setPngDpi,
    svgAtPixelSize,
    type Label,
    type LabelFonts,
  } from '../../lib/labels';

  /*
   * The form is the state: every input event rebuilds the label from the
   * form's current values and swaps the preview. What is on screen is the
   * exact SVG that downloads, and the PNG is that SVG drawn onto a canvas.
   */

  type Kind = 'round' | 'square';
  const STORAGE_KEY = 'zz-pos-label-v2';
  const BLEED_MM = 2;

  const form = document.getElementById('label-form') as HTMLFormElement;
  const preview = document.getElementById('label-preview') as HTMLDivElement;
  const sizeNote = document.getElementById('label-size') as HTMLParagraphElement;
  const warnings = document.getElementById('label-warnings') as HTMLUListElement;
  const svgButton = document.getElementById('download-svg') as HTMLButtonElement;
  const pngButton = document.getElementById('download-png') as HTMLButtonElement;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.label-tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const source = document.getElementById('square-source') as HTMLSelectElement | null;

  const bundles: { id: string; title: string; items: string[] }[] = JSON.parse(
    document.getElementById('label-bundles')?.textContent || '[]',
  );

  let kind: Kind = 'round';
  let fonts: LabelFonts | null = null;
  let current: Label | null = null;

  const value = (name: string) => String(new FormData(form).get(name) ?? '');
  const dpi = () => Number(value('dpi')) || 600;

  function setKind(next: Kind) {
    kind = next;
    for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.kind === kind));
    for (const p of panels) p.hidden = p.dataset.panel !== kind;
  }

  // ── remembering the last label ───────────────────────────────────────────

  function save() {
    try {
      const data = Object.fromEntries(new FormData(form).entries());
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ kind, data }));
    } catch {
      // Private mode or a full quota — the label still works, it just won't be remembered.
    }
  }

  function restore() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
      if (!saved?.data) return;
      for (const el of form.elements) {
        if (!(el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)) continue;
        if (!el.name) continue;
        if (el.type === 'checkbox') el.checked = el.name in saved.data;
        else if (el.type === 'radio') el.checked = saved.data[el.name] === el.value;
        else if (typeof saved.data[el.name] === 'string') el.value = saved.data[el.name];
      }
      const dpiSelect = document.getElementById('label-dpi') as HTMLSelectElement;
      if (typeof saved.data.dpi === 'string') dpiSelect.value = saved.data.dpi;
      if (!dpiSelect.value) dpiSelect.value = '600';
      if (saved.kind === 'square' || saved.kind === 'round') setKind(saved.kind);
    } catch {
      // Unreadable storage is the same as none.
    }
  }

  // ── drawing ──────────────────────────────────────────────────────────────

  function build(): Label | null {
    if (!fonts) return null;
    const colourway = value('colourway');
    const options = {
      colourway: isColourway(colourway) ? colourway : undefined,
      bleedMm: value('bleed') ? BLEED_MM : 0,
    };
    return kind === 'round'
      ? buildRoundLabel({ ...options, message: value('roundMessage'), tagline: value('roundTagline') }, fonts)
      : buildSquareLabel(
          {
            ...options,
            bundleName: value('squareName'),
            items: value('squareItems').split('\n'),
            totalWeight: value('squareWeight'),
            material: value('squareMaterial'),
          },
          fonts,
        );
  }

  function render() {
    current = build();
    if (!current) return;
    // Safe to inject: the builder outlines every typed character into path
    // data, so no user text reaches the markup except the escaped <title>.
    preview.innerHTML = current.svg;
    const mm = current.sizeMm;
    const px = mmToPx(mm, dpi());
    sizeNote.textContent = `${mm} × ${mm} mm · PNG ${px} × ${px} px`;
    warnings.replaceChildren(
      ...current.warnings.map((text) => Object.assign(document.createElement('li'), { textContent: text })),
    );
    warnings.hidden = current.warnings.length === 0;
    save();
  }

  // ── downloading ──────────────────────────────────────────────────────────

  function download(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = Object.assign(document.createElement('a'), { href: url, download: filename });
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  const filename = (extension: string) =>
    kind === 'round'
      ? `zippyzack-thank-you-sticker.${extension}`
      : `zippyzack-bundle-label-${labelSlug(value('squareName'), 'untitled')}.${extension}`;

  async function rasterise(label: Label, resolution: number): Promise<Blob> {
    const px = mmToPx(label.sizeMm, resolution);
    const url = URL.createObjectURL(new Blob([svgAtPixelSize(label.svg, px)], { type: 'image/svg+xml' }));
    try {
      const image = new Image();
      image.src = url;
      await image.decode();
      const canvas = Object.assign(document.createElement('canvas'), { width: px, height: px });
      const context = canvas.getContext('2d');
      if (!context) throw new Error('This browser could not create a canvas that size.');
      context.drawImage(image, 0, 0, px, px);
      const png = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
      if (!png) throw new Error('This browser could not create a PNG that size — try a lower resolution.');
      const stamped = setPngDpi(new Uint8Array(await png.arrayBuffer()), resolution);
      return new Blob([stamped], { type: 'image/png' });
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  svgButton.addEventListener('click', () => {
    if (current) download(new Blob([current.svg], { type: 'image/svg+xml' }), filename('svg'));
  });

  pngButton.addEventListener('click', async () => {
    if (!current) return;
    const idle = pngButton.textContent;
    pngButton.disabled = true;
    pngButton.textContent = 'Rendering…';
    try {
      download(await rasterise(current, dpi()), filename('png'));
    } catch (error) {
      alert(error instanceof Error ? error.message : 'Could not create the PNG.');
    } finally {
      pngButton.disabled = false;
      pngButton.textContent = idle;
    }
  });

  // ── wiring ───────────────────────────────────────────────────────────────

  for (const t of tabs) {
    t.addEventListener('click', () => {
      setKind(t.dataset.kind as Kind);
      render();
    });
  }

  form.addEventListener('input', render);
  form.addEventListener('submit', (event) => event.preventDefault());
  // The resolution select sits outside the form element, beside the buttons.
  document.getElementById('label-dpi')?.addEventListener('change', render);

  source?.addEventListener('change', () => {
    const bundle = bundles.find((b) => b.id === source.value);
    if (!bundle) return;
    (form.elements.namedItem('squareName') as HTMLInputElement).value = bundle.title;
    (form.elements.namedItem('squareItems') as HTMLTextAreaElement).value = bundle.items.join('\n');
    source.value = '';
    render();
  });

  restore();

  async function loadFonts(): Promise<LabelFonts> {
    const entries = await Promise.all(
      Object.entries(LABEL_FONT_FILES).map(async ([key, path]) => {
        const response = await fetch(path);
        if (!response.ok) throw new Error(`${path} returned ${response.status}`);
        return [key, parse(await response.arrayBuffer())] as const;
      }),
    );
    return Object.fromEntries(entries) as unknown as LabelFonts;
  }

  loadFonts()
    .then((loaded) => {
      fonts = loaded;
      svgButton.disabled = false;
      pngButton.disabled = false;
      render();
    })
    .catch((error) => {
      preview.innerHTML = '';
      preview.append(
        Object.assign(document.createElement('p'), {
          className: 'py-24 text-center text-sm font-semibold text-lemon-deep',
          textContent: `Could not load the label fonts (${error instanceof Error ? error.message : 'unknown error'}). Reload to try again.`,
        }),
      );
    });
</script>
