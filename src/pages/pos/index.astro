---
export const prerender = false;

import PosLayout from '../../layouts/PosLayout.astro';
import Flash from '../../components/pos/Flash.astro';
import { isAuthed, loginUrl } from '../../lib/auth';
import { getSupabaseAdmin, isAdminConfigured } from '../../lib/supabaseAdmin';
import { costing, money0, pct, totals } from '../../lib/costing';
import type { Category, Make, Product } from '../../lib/database.types';
import { ON_IMG_ERROR, productImage } from '../../lib/images';

if (!isAuthed(Astro.cookies)) {
  return Astro.redirect(loginUrl(Astro.url));
}

const admin = getSupabaseAdmin();

let products: Product[] = [];
let categories: Category[] = [];
let makes: Make[] = [];
let loadError: string | null = null;

if (!admin) {
  loadError = isAdminConfigured
    ? null
    : 'Supabase is not connected yet. Add PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to your .env, then run supabase/pos-schema.sql.';
} else {
  const [productRes, categoryRes, makeRes] = await Promise.all([
    admin.from('products').select('*').order('created_at', { ascending: false }),
    admin.from('categories').select('*').order('display_order', { ascending: true }),
    admin.from('makes').select('*').order('display_order', { ascending: true }),
  ]);

  // Makes are optional: the dashboard still works before makes-schema.sql has
  // been run, it just shows zero of them.
  makes = makeRes.error ? [] : ((makeRes.data ?? []) as Make[]);

  if (productRes.error || categoryRes.error) {
    loadError = `Could not read from Supabase: ${
      productRes.error?.message ?? categoryRes.error?.message
    }. Have you run supabase/pos-schema.sql?`;
  } else {
    products = productRes.data ?? [];
    categories = categoryRes.data ?? [];
  }
}

const live = products.filter((p) => p.is_active);
const outOfStock = products.filter((p) => p.is_active && p.stock === 0);
const lowStock = products.filter((p) => p.is_active && p.stock > 0 && p.stock <= 3);
const featured = products.filter((p) => p.is_active && p.is_featured);
const inventoryValue = live.reduce((sum, p) => sum + Number(p.price) * p.stock, 0);
const uncategorised = products.filter((p) => !p.category_id);

const liveMakes = makes.filter((m) => m.is_active);
const costs = totals(products.map(costing));

const stats = [
  { label: 'Live products', value: String(live.length), sub: `${products.length} total` },
  {
    label: 'Live makes',
    value: String(liveMakes.length),
    sub: makes.length ? `${makes.length} total` : 'none added yet',
  },
  {
    label: 'Inventory value',
    value: `${inventoryValue.toLocaleString('en-US', { maximumFractionDigits: 0 })}`,
    sub: 'price × stock, live items',
  },
  {
    label: 'Blended margin',
    value: pct(costs.blendedMarginPct),
    sub: costs.unpriced
      ? `${costs.unpriced} item${costs.unpriced === 1 ? '' : 's'} not costed`
      : `${money0(costs.potentialProfit)} of profit on the shelf`,
  },
];

const recent = products.slice(0, 6);
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('error');
---

<PosLayout title="Dashboard" section="dashboard">
  <header class="mb-7">
    <p class="text-micro font-bold uppercase tracking-eyebrow text-ink-muted">Back office</p>
    <h1 class="mt-1 font-display text-3xl font-extrabold text-ink sm:text-4xl">Dashboard</h1>
    <p class="mt-1.5 text-sm text-ink-muted">
      Everything you add here shows up on the <a href="/store" class="font-semibold text-mint-deep hover:underline">shop page</a>.
    </p>
  </header>

  <Flash ok={ok} error={err ?? loadError} />

  <!-- Stats -->
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      stats.map((s) => (
        <div class="rounded-card border border-cream-300 bg-paper p-5 shadow-sm">
          <p class="text-micro font-bold uppercase tracking-eyebrow text-ink-muted">{s.label}</p>
          <p class="mt-2 font-display text-3xl font-extrabold text-ink">{s.value}</p>
          <p class="mt-0.5 text-xs text-ink-muted">{s.sub}</p>
        </div>
      ))
    }
  </div>

  <!-- Quick actions -->
  <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <a
      href="/pos/products/new"
      class="group rounded-card border border-cream-300 bg-paper p-5 shadow-sm transition-all duration-base ease-out hover:-translate-y-0.5 hover:shadow-lg"
    >
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-field bg-mint text-ink">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 5v14M5 12h14" />
        </svg>
      </span>
      <h3 class="mt-3 font-display text-base font-bold text-ink">Add a product</h3>
      <p class="mt-0.5 text-xs text-ink-muted">Name it, price it, pick a category, publish.</p>
    </a>

    <a
      href="/pos/makes/new"
      class="group rounded-card border border-cream-300 bg-paper p-5 shadow-sm transition-all duration-base ease-out hover:-translate-y-0.5 hover:shadow-lg"
    >
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-field bg-lemon text-ink">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0V3m-7.5 5h15m-15 8h15" />
        </svg>
      </span>
      <h3 class="mt-3 font-display text-base font-bold text-ink">Add a make</h3>
      <p class="mt-0.5 text-xs text-ink-muted">Paste a Pinterest link, bundle the materials.</p>
    </a>

    <a
      href="/pos/materials"
      class="group rounded-card border border-cream-300 bg-paper p-5 shadow-sm transition-all duration-base ease-out hover:-translate-y-0.5 hover:shadow-lg"
    >
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-field bg-mint text-ink">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 8c-1.66 0-3 .9-3 2s1.34 2 3 2 3 .9 3 2-1.34 2-3 2m0-8V6m0 12v-2m9-4a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </span>
      <h3 class="mt-3 font-display text-base font-bold text-ink">Material cost</h3>
      <p class="mt-0.5 text-xs text-ink-muted">
        {costs.unpriced ? `${costs.unpriced} still need a cost.` : 'Costs, suppliers and margins.'}
      </p>
    </a>

    <a
      href="/pos/products?stock=low"
      class="group rounded-card border border-cream-300 bg-paper p-5 shadow-sm transition-all duration-base ease-out hover:-translate-y-0.5 hover:shadow-lg"
    >
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-field bg-forest text-paper">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z" />
        </svg>
      </span>
      <h3 class="mt-3 font-display text-base font-bold text-ink">Needs attention</h3>
      <p class="mt-0.5 text-xs text-ink-muted">
        {outOfStock.length} sold out · {lowStock.length} low
        {uncategorised.length > 0 && ` · ${uncategorised.length} uncategorised`}
      </p>
    </a>
  </div>

  <!-- Recently added -->
  <section class="mt-8">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-display text-xl font-bold text-ink">Recently added</h2>
      <a
        href="/pos/products"
        class="text-xs font-bold text-mint-deep transition-colors duration-fast ease-out hover:text-ink"
      >
        All products →
      </a>
    </div>

    {
      recent.length === 0 ? (
        <div class="rounded-card border border-dashed border-cream-400 bg-paper/60 px-6 py-12 text-center">
          <p class="text-3xl">🧶</p>
          <h3 class="mt-3 font-display text-lg font-bold text-ink">No products yet</h3>
          <p class="mt-1 text-sm text-ink-muted">
            {loadError
              ? 'Connect Supabase and run the schema script to get started.'
              : 'Add your first one and it will appear in the shop straight away.'}
          </p>
          {!loadError && (
            <a
              href="/pos/products/new"
              class="mt-5 inline-block rounded-pill bg-btn-gradient px-6 py-2.5 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105"
            >
              Add a product
            </a>
          )}
        </div>
      ) : (
        <ul class="divide-y divide-cream-300 overflow-hidden rounded-card border border-cream-300 bg-paper shadow-sm">
          {recent.map((p) => (
            <li>
              <a
                href={`/pos/products/${p.id}`}
                class="flex items-center gap-4 px-4 py-3 transition-colors duration-fast ease-out hover:bg-cream-50"
              >
                <img
                  src={productImage(p.images?.[0])}
                  onerror={ON_IMG_ERROR}
                  alt=""
                  class="h-11 w-11 shrink-0 rounded-field object-cover"
                  loading="lazy"
                />
                <div class="min-w-0 flex-1">
                  <p class="truncate font-display text-sm font-bold text-ink">{p.name}</p>
                  <p class="truncate text-xs text-ink-muted">
                    {p.category} · {p.stock} in stock
                  </p>
                </div>
                <span class="shrink-0 font-display text-sm font-extrabold text-ink">
                  ${Number(p.price).toFixed(2)}
                </span>
                <span
                  class={`shrink-0 rounded-pill px-2.5 py-1 text-micro font-bold uppercase tracking-wide ${
                    p.is_active ? 'bg-mint-wash text-mint-deep' : 'bg-cream-200 text-ink-muted'
                  }`}
                >
                  {p.is_active ? 'Live' : 'Draft'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</PosLayout>
