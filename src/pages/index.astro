---
// The featured row is live data, so ticking "Featured" in the POS changes the
// homepage without a rebuild.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../lib/catalog';

const featuredProducts = (await getProducts()).filter((p) => p.is_featured).slice(0, 3);

/*
 * Shop by Type. A photograph per category, not an emoji: the five options are
 * the difference between buying yarn, buying a hook and buying a whole project,
 * and a picture of each settles that faster than a label does.
 *
 * The photos are chosen to show exactly what the category contains and nothing
 * more — yarn alone for Yarn Only, yarn beside scissors for Yarn + Tools, bare
 * hooks for Tools — so the pictures themselves draw the distinction. `alt`
 * describes the photograph rather than repeating the name beside it.
 */
const categories = [
  {
    name: 'Yarn Only',
    href: '/store?category=Yarn',
    photo: '/assets/products/yarn-rolls-natural.jpg',
    alt: 'Three balls of wool in oatmeal and olive on a wooden table',
  },
  {
    name: 'Yarn + Tools',
    href: '/store?category=Kits',
    photo: '/assets/products/kit-yarn-tools.jpg',
    alt: 'Cotton yarn in peach, pink and yellow laid out beside gold scissors',
  },
  {
    name: 'Tools',
    href: '/store?category=Tools',
    photo: '/assets/products/hook-set-arranged.jpg',
    alt: 'A fan of crochet hooks with pastel grips',
  },
  {
    name: 'Project Bundles',
    href: '/store?category=Bundles',
    photo: '/assets/products/flatlay-yarn-hooks.jpg',
    alt: 'Red yarn, hooks, buttons and a zip laid out beside a half-finished piece',
  },
  {
    name: 'Patterns',
    href: '/store?category=Patterns',
    photo: '/assets/products/amigurumi-bunny-kit.jpg',
    alt: 'An open pattern booklet with the crocheted bunny it makes',
  },
];

const trustPoints = ['Project-Ready Bundles', 'Ships Worldwide', 'Quality Yarn & Tools'];

const patternTools = [
  { icon: '🧮', label: 'Stitch Calculator' },
  { icon: '📏', label: 'Gauge Guide' },
  { icon: '🪝', label: 'Hook Size Chart' },
  { icon: '🔢', label: 'Row Counter' },
  { icon: '📄', label: 'Pattern Export' },
  { icon: '🧶', label: 'Yarn Weight' },
];

// Shared button recipes. Primary sits on a LIGHT gradient, so its label is ink.
const btnPrimary =
  'inline-flex items-center gap-2 rounded-pill bg-btn-gradient px-8 py-4 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105 active:scale-[.97]';
const btnSecondary =
  'inline-flex items-center gap-2 rounded-pill border border-cream-300 bg-paper px-8 py-4 text-sm font-bold text-ink shadow-xs transition-all duration-fast ease-out hover:-translate-y-0.5 active:scale-[.97]';
const btnSoft =
  'inline-flex items-center gap-2 rounded-pill bg-mint-wash px-8 py-4 text-sm font-bold text-mint-deep transition-all duration-fast ease-out hover:-translate-y-0.5 hover:bg-mint-soft active:scale-[.97]';
const btnGhost =
  'group inline-flex items-center gap-2 rounded-pill px-4 py-2 text-sm font-bold text-ink-body transition-all duration-fast ease-out hover:bg-cream-200';
---

<Layout
  title="Welcome"
  description="Quality yarn kits and crochet tools for every project — everything you need to create."
>
  <!-- ============================================================
       Hero — --hero-wash. No glow orbs: they read as noise at brand
       scale. The one italic Newsreader word is the signature move.
       ============================================================ -->
  <section class="bg-hero-wash pb-24 pt-20">
    <div
      class="mx-auto grid max-w-container items-center gap-16 px-4 sm:px-6 lg:grid-cols-2 lg:px-8"
    >
      <div class="order-2 lg:order-1">
        <span class="zz-eyebrow">Your next crochet project starts here</span>
        <h1
          class="mt-3 font-display text-display-1 font-extrabold text-ink"
        >
          Everything you need to <span class="zz-emph">create</span>
        </h1>
        <p class="mt-5 max-w-md text-[17px] leading-relaxed text-ink-body">
          Get project-ready yarn kits, quality tools, or shop separately — I bundle exactly what
          you need for your next crochet masterpiece.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/store" class={btnPrimary}>
            Browse Yarn Kits
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a href="/gallery" class={btnGhost}>
            View Gallery
            <svg
              class="h-4 w-4 transition-transform duration-base ease-out group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>

        <!-- Trust row — ✦ is the eyebrow leader glyph -->
        <div class="mt-11 flex flex-wrap gap-6">
          {
            trustPoints.map((point) => (
              <div class="flex items-center gap-2 text-[13.5px] text-ink-muted">
                <span class="text-[11px] text-mint-deep">✦</span>
                {point}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Photo collage: 24px radius, shadow-lg, offset second column,
           with a floating paper card breaking the bottom edge. -->
      <div class="relative order-1 lg:order-2">
        <div class="grid grid-cols-2 gap-4">
          <div class="grid gap-4">
            <img
              src="/assets/homepage-photos/pexels-arina-krasnikova-5709862.jpg"
              alt="Colourful yarn collection"
              class="aspect-[3/4] w-full rounded-photo object-cover shadow-lg"
              loading="eager"
            />
            <img
              src="/assets/homepage-photos/pexels-kseniachernaya-5807027.jpg"
              alt="Crochet project in progress"
              class="aspect-square w-full rounded-photo object-cover shadow-lg"
              loading="lazy"
            />
          </div>
          <div class="mt-8 grid gap-4">
            <img
              src="/assets/homepage-photos/pexels-kumoknits-4601228.jpg"
              alt="Yarn and crochet hooks"
              class="aspect-square w-full rounded-photo object-cover shadow-lg"
              loading="lazy"
            />
            <img
              src="/assets/homepage-photos/pexels-maria-sardar-15862201-6905162.jpg"
              alt="Finished crochet piece"
              class="aspect-[3/4] w-full rounded-photo object-cover shadow-lg"
              loading="lazy"
            />
          </div>
        </div>

        <a
          href="/store?sort=newest"
          class="group absolute -bottom-5 left-4 flex items-center gap-3 rounded-card bg-paper px-5 py-3.5 shadow-xl transition-all duration-fast ease-out hover:-translate-y-0.5 hover:shadow-2xl"
        >
          <div
            class="flex h-10 w-10 items-center justify-center rounded-pill bg-lemon-wash text-xl"
          >
            🧶
          </div>
          <div>
            <p class="text-micro text-ink-muted">New arrivals</p>
            <p class="text-[13.5px] font-bold text-ink">Autumn Yarn Collection</p>
            <span class="mt-1 flex items-center gap-1 text-micro font-bold text-mint-deep">
              Shop new arrivals
              <svg
                class="h-3 w-3 transition-transform duration-fast ease-out group-hover:translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Shop by Type — paper band
       ============================================================ -->
  <section class="bg-paper py-24">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="mb-9 text-center">
        <h2 class="font-display text-[28px] font-extrabold text-ink">Shop by Type</h2>
        <p class="mt-2 text-ink-body">Find the right supplies for your project</p>
      </div>
      <!--
        Same card grammar as the product and make tiles — paper fill, cream
        hairline, photo lifting on hover — so a category reads as one of the
        shop's own objects rather than as navigation furniture. Five across on
        a wide screen, two on a phone.
      -->
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {
          categories.map((cat) => (
            <a
              href={cat.href}
              class="group flex flex-col overflow-hidden rounded-card border border-cream-300 bg-paper shadow-sm transition-all duration-base ease-out hover:-translate-y-0.5 hover:shadow-lg"
            >
              <div class="aspect-[4/3] overflow-hidden bg-cream-200">
                <img
                  src={cat.photo}
                  alt={cat.alt}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-lazy ease-out group-hover:scale-[1.04]"
                />
              </div>
              <div class="flex items-center justify-between gap-2 px-4 py-3.5">
                <span class="font-display text-sm font-bold leading-snug text-ink">{cat.name}</span>
                <svg
                  class="h-4 w-4 shrink-0 text-ink-faint transition-all duration-base ease-out group-hover:translate-x-0.5 group-hover:text-mint-deep"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-8 flex justify-center">
        <a href="/store" class={btnGhost}>
          View all
          <svg
            class="h-4 w-4 transition-transform duration-base ease-out group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Featured Kits — sunken band (cream-200)
       ============================================================ -->
  <section class="bg-cream-200 py-24">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <span class="zz-eyebrow">Popular Picks</span>
          <h2 class="mt-2 font-display text-[28px] font-extrabold text-ink">Yarn, hooks &amp; kits</h2>
        </div>
        <a href="/store" class={`${btnGhost} shrink-0`}>
          View all
          <svg
            class="h-4 w-4 transition-transform duration-base ease-out group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            />
          </svg>
        </a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- ============================================================
       Pattern generator — the one full-bleed --btn-gradient band.
       It is a LIGHT gradient, so everything on it is ink dark.
       ============================================================ -->
  <section class="bg-btn-gradient py-[88px] text-ink">
    <div
      class="mx-auto grid max-w-container items-center gap-12 px-4 py-2 sm:px-6 lg:grid-cols-2 lg:px-8"
    >
      <div>
        <span class="zz-eyebrow zz-eyebrow--on-accent">Free Tool</span>
        <h2 class="mt-2 font-display text-display-2 font-extrabold text-ink">
          Generate your own crochet pattern
        </h2>
        <p class="mt-4 max-w-md text-[17px] leading-relaxed text-forest-deep/90">
          Use my free pattern generator to calculate stitch counts, plan your hook size, and export
          a printable pattern — no experience needed.
        </p>
        <div class="mt-8">
          <a href="/pattern-generator" class={btnSecondary}>
            Try Pattern Generator
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
      </div>

      <!-- Glass tiles: paper at 55% + 6px blur keeps ink labels above 4.5:1. -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          patternTools.map((tool) => (
            <div class="zz-glass rounded-card px-3 py-4 text-center">
              <div class="text-[22px]">{tool.icon}</div>
              <p class="mt-1.5 text-micro font-bold text-ink">{tool.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       My Story — paper band
       ============================================================ -->
  <section id="about" class="bg-paper py-24">
    <div
      class="mx-auto grid max-w-container items-center gap-16 px-4 sm:px-6 lg:grid-cols-2 lg:px-8"
    >
      <div class="relative">
        <img
          src="/assets/homepage-photos/pexels-rahimegul-29889872.jpg"
          alt="Yarn collection and crochet supplies"
          class="aspect-square w-full rounded-[32px] object-cover shadow-xl"
          loading="lazy"
        />
        <!-- StatTile, breaking the photo edge -->
        <div
          class="absolute -bottom-6 right-0 rounded-card border border-cream-300 bg-paper px-6 py-5 shadow-xl lg:-right-6"
        >
          <p class="font-display text-[36px] font-extrabold leading-none text-mint-deep">100+</p>
          <p class="mt-1.5 text-[13.5px] text-ink-muted">projects enabled</p>
        </div>
      </div>

      <div>
        <span class="zz-eyebrow">My Story</span>
        <h2 class="mt-2 font-display text-[28px] font-extrabold leading-snug text-ink">
          Made by hand, with intention
        </h2>
        <div class="mt-5 flex flex-col gap-3.5 leading-relaxed text-ink-body">
          <p>
            Hi! I'm the maker behind ZippyZack.com — a curated shop for crocheters who want quality
            yarn and tools without the guesswork.
          </p>
          <p>
            Every kit is carefully bundled with exactly what you need for a specific project — from
            beginner-friendly amigurumi to advanced garments. Buy yarn only, add tools, or grab a
            complete project bundle.
          </p>
          <p>
            Can't find what you're looking for? Request a new product and I'll do my best to source
            it for you!
          </p>
        </div>
        <div class="mt-7 flex flex-wrap gap-4">
          <a href="/store" class={btnPrimary}>Browse All Products</a>
          <a href="/request-product" class={btnSoft}>Request a Product</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Newsletter — --forest-wash band
       ============================================================ -->
  <section class="bg-forest-wash py-[72px] text-center">
    <div class="mx-auto max-w-narrow px-4 sm:px-6 lg:px-8">
      <div class="text-[34px]">💌</div>
      <h2 class="mt-2 font-display text-[28px] font-extrabold text-ink">Join the maker's list</h2>
      <p class="mx-auto mt-2 max-w-md text-ink-body">
        Get first access to new yarn arrivals, kit releases, and exclusive crochet tips.
      </p>
      <form
        class="mx-auto mt-7 flex max-w-md flex-col gap-3 sm:flex-row"
        onsubmit="return false;"
      >
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          placeholder="your@email.com"
          class="flex-1 rounded-field border border-cream-300 bg-paper px-5 py-3.5 text-sm text-ink placeholder:text-ink-faint"
          required
        />
        <button
          type="submit"
          class="whitespace-nowrap rounded-pill bg-btn-gradient px-7 py-3.5 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105 active:scale-[.97]"
        >
          Subscribe
        </button>
      </form>
      <p class="mt-3 text-xs text-ink-muted">No spam. Unsubscribe any time.</p>
    </div>
  </section>
</Layout>
