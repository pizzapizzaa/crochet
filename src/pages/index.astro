---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { mockProducts } from '../lib/mockData';

// In production, replace with: const { data: products } = await supabase.from('products').select().eq('is_featured', true).limit(3);
const featuredProducts = mockProducts.filter((p) => p.is_featured).slice(0, 3);

const categories = [
  { name: 'Yarn Only', icon: '🧶', href: '/store?category=Yarn' },
  { name: 'Yarn + Tools', icon: '🪝', href: '/store?category=Kits' },
  { name: 'Tools', icon: '✂️', href: '/store?category=Tools' },
  { name: 'Project Bundles', icon: '📦', href: '/store?category=Bundles' },
  { name: 'Patterns', icon: '📄', href: '/store?category=Patterns' },
];
---

<Layout title="Welcome" description="Quality yarn kits and crochet tools for every project — everything you need to create.">
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-brand-gradient">
    <!-- Decorative yarn circles -->
    <div
      class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-sky/20 blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-32 -left-16 w-80 h-80 rounded-full bg-mint/20 blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid lg:grid-cols-2 gap-16 items-center">
      <!-- Text -->
      <div class="order-2 lg:order-1">
        <span
          class="inline-block text-mint-dark text-sm font-medium tracking-widest uppercase mb-4"
        >
          Your next crochet project starts here
        </span>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-semibold text-slate-dark leading-tight">
          Everything you need to
          <em class="text-mint-dark not-italic">create</em>
        </h1>
        <p class="mt-6 text-slate-warm text-lg leading-relaxed max-w-md">
          Get project-ready yarn kits, quality tools, or shop separately — we bundle exactly what
          you need for your next crochet masterpiece.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="/store"
            class="inline-flex items-center gap-2 bg-btn-gradient text-paper hover:brightness-105 font-semibold px-8 py-3.5 rounded-full transition-all duration-200 text-sm"
          >
            Browse Yarn Kits
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a
            href="/gallery"
            class="inline-flex items-center gap-2 text-slate-warm hover:text-mint-dark font-medium text-sm transition-colors group"
          >
            View Gallery
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>

        <!-- Trust badges -->
        <div class="mt-12 flex flex-wrap gap-6">
          {
            [
              { icon: '✦', text: 'Project-Ready Bundles' },
              { icon: '✦', text: 'Ships Worldwide' },
              { icon: '✦', text: 'Quality Yarn & Tools' },
            ].map((badge) => (
              <div class="flex items-center gap-2 text-sm text-slate-light">
                <span class="text-mint-dark text-xs">{badge.icon}</span>
                {badge.text}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Hero image collage -->
      <div class="order-1 lg:order-2 relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="rounded-3xl overflow-hidden aspect-[3/4] shadow-xl">
              <img
                src="/assets/homepage-photos/pexels-arina-krasnikova-5709862.jpg"
                alt="Colorful yarn collection"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="rounded-3xl overflow-hidden aspect-square shadow-lg">
              <img
                src="/assets/homepage-photos/pexels-kseniachernaya-5807027.jpg"
                alt="Crochet project in progress"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
          <div class="space-y-4 mt-8">
            <div class="rounded-3xl overflow-hidden aspect-square shadow-lg">
              <img
                src="/assets/homepage-photos/pexels-kumoknits-4601228.jpg"
                alt="Yarn and crochet hooks"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="rounded-3xl overflow-hidden aspect-[3/4] shadow-xl">
              <img
                src="/assets/homepage-photos/pexels-maria-sardar-15862201-6905162.jpg"
                alt="Finished crochet piece"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Floating badge -->
        <div
          class="absolute -bottom-4 left-4 bg-white rounded-2xl shadow-xl px-5 py-4 flex items-center gap-3"
        >
          <div class="w-10 h-10 bg-mint/20 rounded-full flex items-center justify-center text-mint-dark text-xl">
            🧶
          </div>
          <div>
            <p class="text-xs text-slate-light">New arrivals</p>
            <p class="text-sm font-semibold text-slate-dark">Autumn Yarn Collection</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl font-semibold text-slate-dark">Shop by Type</h2>
        <p class="mt-3 text-slate-warm">Find the right supplies for your project</p>
      </div>
      <div class="flex flex-wrap justify-center gap-4">
        {
          categories.map((cat) => (
            <a
              href={cat.href}
              class="flex items-center gap-2 bg-mint-muted/50 hover:bg-mint hover:text-paper text-slate-warm font-medium px-6 py-3 rounded-full text-sm transition-all duration-200 group"
            >
              <span class="text-lg">{cat.icon}</span>
              {cat.name}
            </a>
          ))
        }
        <a
          href="/store"
          class="flex items-center gap-2 border border-slate-light/30 hover:border-mint hover:text-mint-dark text-slate-light font-medium px-6 py-3 rounded-full text-sm transition-all duration-200"
        >
          View All →
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-20 bg-sky-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-sky-dark text-sm font-medium tracking-widest uppercase">Popular Picks</span>
          <h2 class="font-serif text-4xl font-semibold text-slate-dark mt-1">Featured Kits</h2>
        </div>
        <a
          href="/store"
          class="text-slate-warm hover:text-mint-dark text-sm font-medium transition-colors shrink-0"
        >
          View all →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- Pattern Generator CTA -->
  <section class="py-20 bg-btn-gradient text-paper overflow-hidden relative">
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-white/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 pointer-events-none"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-paper/80 text-sm font-medium tracking-widest uppercase">Free Tool</span>
          <h2 class="font-serif text-4xl sm:text-5xl font-semibold mt-2 leading-tight">
            Generate your own crochet pattern
          </h2>
          <p class="mt-4 text-paper/90 leading-relaxed max-w-md">
            Use my free pattern generator to calculate stitch counts, plan your hook size, and
            export a printable pattern — no experience needed.
          </p>
          <a
            href="/pattern-generator"
            class="mt-8 inline-flex items-center gap-2 bg-paper text-ink font-semibold px-8 py-3.5 rounded-full hover:bg-white transition-all text-sm shadow-sm"
          >
            Try Pattern Generator
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
        <div class="hidden lg:grid grid-cols-3 gap-3">
          {
            [
              { label: 'Stitch Calculator', icon: '🧮' },
              { label: 'Gauge Guide', icon: '📏' },
              { label: 'Hook Size Chart', icon: '🪝' },
              { label: 'Row Counter', icon: '🔢' },
              { label: 'Pattern Export', icon: '📄' },
              { label: 'Yarn Weight', icon: '🧶' },
            ].map((feature) => (
              <div class="bg-white/40 backdrop-blur rounded-2xl p-4 text-center">
                <div class="text-2xl mb-2">{feature.icon}</div>
                <p class="text-xs font-medium text-slate-dark">{feature.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- About / Story -->
  <section id="about" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="relative">
          <div class="rounded-3xl overflow-hidden aspect-square shadow-2xl">
            <img
              src="/assets/homepage-photos/pexels-rahimegul-29889872.jpg"
              alt="Yarn collection and crochet supplies"
              class="w-full h-full object-cover"
            />
          </div>
          <div
            class="absolute -bottom-6 -right-6 bg-mint-muted rounded-2xl shadow-xl p-5 max-w-[200px]"
          >
            <p class="font-serif text-3xl font-bold text-mint-dark">100+</p>
            <p class="text-sm text-slate-warm mt-1">projects enabled</p>
          </div>
        </div>
        <div>
          <span class="text-mint-dark text-sm font-medium tracking-widest uppercase"
            >My Story</span
          >
          <h2 class="font-serif text-4xl font-semibold text-slate-dark mt-2 leading-tight">
            Made by hand, with intention
          </h2>
          <div class="space-y-4 mt-6 text-slate-warm leading-relaxed">
            <p>
              Hi! I'm the maker behind ZippyZack.com — a curated shop for crocheters who want
              quality yarn and tools without the guesswork.
            </p>
            <p>
              Every kit is carefully bundled with exactly what you need for a specific project —
              from beginner-friendly amigurumi to advanced garments. Buy yarn only, add tools, or
              grab a complete project bundle.
            </p>
            <p>
              Can't find what you're looking for? Request a new product and I'll do my best to
              source it for you!
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/store"
              class="inline-flex items-center gap-2 bg-btn-gradient text-paper hover:brightness-105 font-semibold px-8 py-3.5 rounded-full transition-all text-sm"
            >
              Browse All Products
            </a>
            <a
              href="/request-product"
              class="inline-flex items-center gap-2 border border-slate-light/40 hover:border-mint hover:text-mint-dark text-slate-warm font-medium px-8 py-3.5 rounded-full transition-all text-sm"
            >
              Request a Product
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-16 bg-sky-muted/40">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="text-4xl mb-4">💌</div>
      <h2 class="font-serif text-3xl font-semibold text-slate-dark">Join the maker's list</h2>
      <p class="mt-3 text-slate-warm text-sm">
        Get first access to new yarn arrivals, kit releases, and exclusive crochet tips.
      </p>
      <form class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="return false;">
        <input
          type="email"
          placeholder="your@email.com"
          class="flex-1 px-5 py-3 rounded-full border border-sky/30 bg-white text-slate-dark text-sm focus:outline-none focus:ring-2 focus:ring-mint/50"
          required
        />
        <button
          type="submit"
          class="bg-btn-gradient text-paper hover:brightness-105 font-semibold px-7 py-3 rounded-full text-sm transition-all whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>
      <p class="mt-3 text-xs text-slate-light">No spam. Unsubscribe any time.</p>
    </div>
  </section>
</Layout>
