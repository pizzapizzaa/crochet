---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { mockProducts } from '../lib/mockData';

// In production, replace with: const { data: products } = await supabase.from('products').select().eq('is_featured', true).limit(3);
const featuredProducts = mockProducts.filter((p) => p.is_featured).slice(0, 3);

const categories = [
  { name: 'Bags', icon: '👜', href: '/store?category=Bags' },
  { name: 'Clothing', icon: '🧥', href: '/store?category=Clothing' },
  { name: 'Accessories', icon: '🧣', href: '/store?category=Accessories' },
  { name: 'Home', icon: '🏡', href: '/store?category=Home' },
  { name: 'Toys', icon: '🧸', href: '/store?category=Toys' },
];
---

<Layout title="Welcome" description="Handcrafted crochet pieces made with love — shop unique creations and explore patterns.">
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden bg-cream-100">
    <!-- Decorative yarn circles -->
    <div
      class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-rose-dust/10 blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -bottom-32 -left-16 w-80 h-80 rounded-full bg-sage/10 blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid lg:grid-cols-2 gap-16 items-center">
      <!-- Text -->
      <div class="order-2 lg:order-1">
        <span
          class="inline-block text-rose-dust text-sm font-medium tracking-widest uppercase mb-4"
        >
          Handmade with love
        </span>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-semibold text-brown-dark leading-tight">
          Crafted for the
          <em class="text-rose-dust not-italic">cozy</em> life
        </h1>
        <p class="mt-6 text-brown-warm text-lg leading-relaxed max-w-md">
          Every piece is hand-crocheted with care — from market totes and sun hats to cosy cardigans
          and whimsical toys. Slow fashion, made to last.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="/store"
            class="inline-flex items-center gap-2 bg-rose-dust hover:bg-rose-dark text-white font-medium px-8 py-3.5 rounded-full transition-colors duration-200 text-sm"
          >
            Shop the Collection
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
          <a
            href="/gallery"
            class="inline-flex items-center gap-2 text-brown-warm hover:text-rose-dust font-medium text-sm transition-colors group"
          >
            View Gallery
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>

        <!-- Trust badges -->
        <div class="mt-12 flex flex-wrap gap-6">
          {
            [
              { icon: '✦', text: '100% Handmade' },
              { icon: '✦', text: 'Ships Worldwide' },
              { icon: '✦', text: 'Custom Orders' },
            ].map((badge) => (
              <div class="flex items-center gap-2 text-sm text-brown-light">
                <span class="text-rose-dust text-xs">{badge.icon}</span>
                {badge.text}
              </div>
            ))
          }
        </div>
      </div>

      <!-- Hero image collage -->
      <div class="order-1 lg:order-2 relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="rounded-3xl overflow-hidden aspect-[3/4] shadow-xl">
              <img
                src="https://images.unsplash.com/photo-1593642632559-0c6d3fc62b89?w=600&q=80"
                alt="Crocheted tote bag"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="rounded-3xl overflow-hidden aspect-square shadow-lg">
              <img
                src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80"
                alt="Amigurumi bunny"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
          <div class="space-y-4 mt-8">
            <div class="rounded-3xl overflow-hidden aspect-square shadow-lg">
              <img
                src="https://images.unsplash.com/photo-1529958030586-3aae4ca485ff?w=600&q=80"
                alt="Sun hat"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="rounded-3xl overflow-hidden aspect-[3/4] shadow-xl">
              <img
                src="https://images.unsplash.com/photo-1585386959984-a4155224a1ad?w=600&q=80"
                alt="Crochet cardigan"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Floating badge -->
        <div
          class="absolute -bottom-4 left-4 bg-white rounded-2xl shadow-xl px-5 py-4 flex items-center gap-3"
        >
          <div class="w-10 h-10 bg-rose-dust/10 rounded-full flex items-center justify-center text-rose-dust text-xl">
            🧶
          </div>
          <div>
            <p class="text-xs text-brown-light">Latest drop</p>
            <p class="text-sm font-semibold text-brown-dark">Granny Square Cardigan</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-4xl font-semibold text-brown-dark">Shop by Category</h2>
        <p class="mt-3 text-brown-warm">Find exactly what you're looking for</p>
      </div>
      <div class="flex flex-wrap justify-center gap-4">
        {
          categories.map((cat) => (
            <a
              href={cat.href}
              class="flex items-center gap-2 bg-cream-100 hover:bg-rose-dust hover:text-white text-brown-warm font-medium px-6 py-3 rounded-full text-sm transition-all duration-200 group"
            >
              <span class="text-lg">{cat.icon}</span>
              {cat.name}
            </a>
          ))
        }
        <a
          href="/store"
          class="flex items-center gap-2 border border-brown-light/30 hover:border-rose-dust hover:text-rose-dust text-brown-light font-medium px-6 py-3 rounded-full text-sm transition-all duration-200"
        >
          View All →
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-20 bg-cream-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-rose-dust text-sm font-medium tracking-widest uppercase">New & Loved</span>
          <h2 class="font-serif text-4xl font-semibold text-brown-dark mt-1">Featured Pieces</h2>
        </div>
        <a
          href="/store"
          class="text-brown-warm hover:text-rose-dust text-sm font-medium transition-colors shrink-0"
        >
          View all →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- Pattern Generator CTA -->
  <section class="py-20 bg-sage text-white overflow-hidden relative">
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 pointer-events-none"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-sage-light text-sm font-medium tracking-widest uppercase">Free Tool</span>
          <h2 class="font-serif text-4xl sm:text-5xl font-semibold mt-2 leading-tight">
            Generate your own crochet pattern
          </h2>
          <p class="mt-4 text-sage-light leading-relaxed max-w-md">
            Use my free pattern generator to calculate stitch counts, plan your hook size, and
            export a printable pattern — no experience needed.
          </p>
          <a
            href="/pattern-generator"
            class="mt-8 inline-flex items-center gap-2 bg-white text-sage-dark font-semibold px-8 py-3.5 rounded-full hover:bg-cream-100 transition-colors text-sm"
          >
            Try Pattern Generator
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
        <div class="hidden lg:grid grid-cols-3 gap-3">
          {
            [
              { label: 'Stitch Calculator', icon: '🧮' },
              { label: 'Gauge Guide', icon: '📏' },
              { label: 'Hook Size Chart', icon: '🪝' },
              { label: 'Row Counter', icon: '🔢' },
              { label: 'Pattern Export', icon: '📄' },
              { label: 'Yarn Weight', icon: '🧶' },
            ].map((feature) => (
              <div class="bg-white/10 backdrop-blur rounded-2xl p-4 text-center">
                <div class="text-2xl mb-2">{feature.icon}</div>
                <p class="text-xs font-medium text-white/90">{feature.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- About / Story -->
  <section id="about" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="relative">
          <div class="rounded-3xl overflow-hidden aspect-square shadow-2xl">
            <img
              src="https://images.unsplash.com/photo-1582582621959-48d27397dc69?w=800&q=80"
              alt="Crocheting in progress"
              class="w-full h-full object-cover"
            />
          </div>
          <div
            class="absolute -bottom-6 -right-6 bg-cream-100 rounded-2xl shadow-xl p-5 max-w-[200px]"
          >
            <p class="font-serif text-3xl font-bold text-rose-dust">5+</p>
            <p class="text-sm text-brown-warm mt-1">years of crocheting</p>
          </div>
        </div>
        <div>
          <span class="text-rose-dust text-sm font-medium tracking-widest uppercase"
            >My Story</span
          >
          <h2 class="font-serif text-4xl font-semibold text-brown-dark mt-2 leading-tight">
            Made by hand, with intention
          </h2>
          <div class="space-y-4 mt-6 text-brown-warm leading-relaxed">
            <p>
              Hi! I'm the maker behind Loopy & Co. — a one-person studio creating slow, thoughtful
              crochet pieces from my little craft corner.
            </p>
            <p>
              Every item is worked up in small batches, using natural fibres where possible. I
              believe in making things that last, things that have a story, and things that bring a
              bit of warmth to everyday life.
            </p>
            <p>
              Custom orders are always welcome — reach out if you have something special in mind!
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/store"
              class="inline-flex items-center gap-2 bg-rose-dust hover:bg-rose-dark text-white font-medium px-8 py-3.5 rounded-full transition-colors text-sm"
            >
              Shop the Collection
            </a>
            <a
              href="/contact"
              class="inline-flex items-center gap-2 border border-brown-light/40 hover:border-rose-dust hover:text-rose-dust text-brown-warm font-medium px-8 py-3.5 rounded-full transition-all text-sm"
            >
              Get in Touch
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-16 bg-cream-200">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="text-4xl mb-4">💌</div>
      <h2 class="font-serif text-3xl font-semibold text-brown-dark">Join the yarn-lover's list</h2>
      <p class="mt-3 text-brown-warm text-sm">
        Get first access to new drops, pattern freebies, and behind-the-scenes peeks.
      </p>
      <form class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="return false;">
        <input
          type="email"
          placeholder="your@email.com"
          class="flex-1 px-5 py-3 rounded-full border border-cream-300 bg-white text-brown-dark text-sm focus:outline-none focus:ring-2 focus:ring-rose-dust/50"
          required
        />
        <button
          type="submit"
          class="bg-rose-dust hover:bg-rose-dark text-white font-medium px-7 py-3 rounded-full text-sm transition-colors whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>
      <p class="mt-3 text-xs text-brown-light">No spam. Unsubscribe any time.</p>
    </div>
  </section>
</Layout>
