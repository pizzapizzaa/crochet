---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import MakeCard from '../../components/MakeCard.astro';
import SectionWave from '../../components/SectionWave.astro';
import { getBundles } from '../../lib/makes';
import { DIFFICULTIES } from '../../lib/database.types';

const allMakes = await getBundles();

const urlSearch = Astro.url.searchParams.get('q') ?? '';
const urlDifficulty = Astro.url.searchParams.get('difficulty') ?? 'All';

let makes = [...allMakes];

if (urlDifficulty !== 'All') {
  makes = makes.filter((m) => m.difficulty === urlDifficulty);
}

if (urlSearch) {
  const q = urlSearch.toLowerCase();
  makes = makes.filter(
    (m) =>
      m.title.toLowerCase().includes(q) ||
      (m.summary ?? '').toLowerCase().includes(q) ||
      m.tags.some((t) => t.toLowerCase().includes(q)),
  );
}

/*
 * Two bands. Featured bundles get lifted out entirely and shown first on the
 * lime row; everything else follows Beginner → Advanced, which for a bundle is
 * the whole point of it. Bundles with no level set sit at the end.
 */
const rank = (difficulty: string | null | undefined) => {
  const i = DIFFICULTIES.indexOf(difficulty as (typeof DIFFICULTIES)[number]);
  return i === -1 ? DIFFICULTIES.length : i;
};

const featured = makes.filter((m) => m.is_featured).sort((a, b) => rank(a.difficulty) - rank(b.difficulty));
const rest = makes.filter((m) => !m.is_featured).sort((a, b) => rank(a.difficulty) - rank(b.difficulty));

const difficulties = ['All', ...DIFFICULTIES.filter((d) => allMakes.some((m) => m.difficulty === d))];
---

<Layout
  title="Bundles"
  description="Crochet kits put together for your level — every yarn and tool you need to start, in one box."
>
  <!-- Header. Its top seam is the wave hanging off the site header. -->
  <section class="relative bg-hero-wash py-12">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <nav class="mb-2 flex items-center gap-1.5 text-xs text-ink-muted">
        <a href="/" class="transition-colors duration-fast ease-out hover:text-mint-deep">Home</a>
        <span>/</span>
        <span class="text-ink-body">Bundles</span>
      </nav>
      <h1 class="font-display text-display-2 font-extrabold text-ink">Bundles</h1>
      <p class="mt-3 max-w-2xl text-ink-body">
        Kits put together for your level, from your very first chain to your next challenge. Every yarn and tool you need, in one box.
      </p>

    </div>
  </section>

  <!--
    Featured row. Full-bleed lime so it reads as a band across the page rather
    than as another card, and the paper cards sit on it at full contrast. Lime
    is a fill: every label on it is ink.
  -->
  {
    featured.length > 0 && (
      <section class="relative bg-lime">
        <SectionWave fill="var(--lime)" variant={1} />
        <div class="mx-auto max-w-container px-4 py-10 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="flex items-center gap-2 font-display text-2xl font-extrabold text-ink">
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-pill bg-ink text-sm text-lime">
                ★
              </span>
              Featured bundles
            </h2>
            <p class="text-sm font-semibold text-ink/80">
              {featured.length} hand-picked to start with
            </p>
          </div>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
            {featured.map((make) => (
              <MakeCard make={make} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!--
    The browsable list. Its own band is the page ground, so its wave is cream
    reaching back up over the lime — which is what closes the featured row.
  -->
  <div class="relative bg-cream-100">
    <SectionWave fill="var(--cream-100)" variant={2} />
    <!--
      Deeper at the bottom than the top: the footer's wave reaches up out of
      the footer and into the end of this band, and at py-12 its crest landed
      on the edge of the card below.
    -->
    <div class="mx-auto max-w-container px-4 pb-24 pt-12 sm:px-6 lg:px-8">
    <!--
      Search and difficulty filter sit with the browsable list they drive,
      under the featured row rather than under the page title.
    -->
    <form method="GET" action="/bundles" class="flex max-w-md gap-2">
      <div class="relative flex-1">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-faint"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="search"
          name="q"
          value={urlSearch}
          placeholder="Search bundles…"
          class="w-full rounded-pill border border-cream-300 bg-paper py-2.5 pl-9 pr-4 text-sm text-ink placeholder-ink-faint focus:border-mint-mid focus:outline-none focus:ring-2 focus:ring-mint/40"
        />
      </div>
      <button
        type="submit"
        class="rounded-pill bg-btn-gradient px-5 py-2.5 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105"
      >
        Go
      </button>
    </form>

    {
      difficulties.length > 1 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {difficulties.map((d) => (
            <a
              href={`/bundles?difficulty=${encodeURIComponent(d as string)}${urlSearch ? `&q=${encodeURIComponent(urlSearch)}` : ''}`}
              class={`rounded-pill px-3.5 py-1.5 text-xs font-bold transition-colors duration-fast ease-out ${
                urlDifficulty === d
                  ? 'bg-forest text-paper'
                  : 'bg-paper text-ink-body hover:bg-cream-200'
              }`}
            >
              {d}
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-8">
    {
      makes.length === 0 ? (
        <div class="py-20 text-center">
          <div class="mb-4 text-5xl">🧶</div>
          <h2 class="font-display text-2xl font-bold text-ink">
            {allMakes.length === 0 ? 'No bundles up yet' : 'Nothing matches that'}
          </h2>
          <p class="mx-auto mt-2 max-w-md text-sm text-ink-muted">
            {allMakes.length === 0
              ? 'We are still putting these together. In the meantime, our makes each come with everything they take.'
              : `No bundles for "${urlSearch || urlDifficulty}".`}
          </p>
          <a
            href={allMakes.length === 0 ? '/makes' : '/bundles'}
            class="mt-6 inline-block rounded-pill bg-btn-gradient px-6 py-2.5 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105"
          >
            {allMakes.length === 0 ? 'See the makes' : 'See all bundles'}
          </a>
        </div>
      ) : (
        rest.length > 0 && (
          <>
            <p class="mb-6 text-sm text-ink-muted">
              {featured.length > 0
                ? `${rest.length} more bundle${rest.length === 1 ? '' : 's'}, easiest first`
                : `${rest.length} bundle${rest.length === 1 ? '' : 's'}, easiest first`}
            </p>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
              {rest.map((make) => (
                <MakeCard make={make} />
              ))}
            </div>
          </>
        )
      )
    }
    </div>

    <!-- How this works -->
    <section class="mt-16 rounded-card border border-cream-300 bg-paper p-6 sm:p-8">
      <h2 class="font-display text-xl font-bold text-ink">How a bundle works</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-3">
        {
          [
            {
              step: '1',
              title: 'Pick your level',
              body: 'Each bundle is put together for a stage — first stitches, first project, or something more ambitious.',
            },
            {
              step: '2',
              title: 'Get the kit',
              body: 'We put every yarn and tool it takes in one kit, for less than buying them apart. Already own a hook or scissors? Untick them and pay less.',
            },
            {
              step: '3',
              title: 'Start making',
              body: 'We sell supplies, not finished pieces — the making is the fun part. Contact us if you need some tutorials.',
            },
          ].map((s) => (
            <div>
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-pill bg-mint font-display text-sm font-extrabold text-ink">
                {s.step}
              </span>
              <h3 class="mt-3 font-display text-base font-bold text-ink">{s.title}</h3>
              <p class="mt-1 text-sm text-ink-muted">{s.body}</p>
            </div>
          ))
        }
      </div>
    </section>
    </div>
  </div>
</Layout>
