  { label: 'About Me', href: '/#about' },
  { label: 'Track My Order', href: '/orders/track' },
  { label: 'Shipping & Returns', href: '/shipping' },
  { label: 'Care Instructions', href: '/care' },
  { label: 'Contact', href: '/contact' },
