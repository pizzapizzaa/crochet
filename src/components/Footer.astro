---

<!-- Dark band: --dark-wash, cream type. The inverse of the gradient CTA. -->
<footer class="relative bg-dark-wash text-cream">
  {/*
    A strand of yarn laid along the seam between the page and the footer, so
    the dark band starts with a drawn line rather than a ruled edge. It rides
    the boundary — half over cream, half over forest — which is why it is
    absolutely positioned and centred on the top edge rather than sitting
    inside either band.

    Same grammar as the loop round the active nav item: preserveAspectRatio is
    off so the wave stretches to whatever the viewport is wide, and
    non-scaling-stroke keeps the strand an even thickness while it stretches.
    Without that the wide screens get a hairline through the flat runs and a
    fat stroke through every turn. The path over- and under-shoots the viewBox
    on both sides so no rounded cap ever appears parked at the screen edge.
  */}
  <span
    class="pointer-events-none absolute inset-x-0 top-0 h-10 -translate-y-1/2 sm:h-14"
    aria-hidden="true"
  >
    <svg class="h-full w-full" viewBox="0 0 1440 56" preserveAspectRatio="none" fill="none">
      <path
        d="M-20 34C90 12 190 8 300 24S500 50 620 36S820 8 960 18S1180 46 1300 30S1420 16 1460 22"
        stroke="#21FFA8"
        stroke-width="4"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
      <path
        d="M-20 30C92 8 192 4 302 20S502 46 622 32S822 4 962 14S1182 42 1302 26S1422 12 1460 18"
        stroke="#A8FFDC"
        stroke-width="1.5"
        stroke-linecap="round"
        opacity="0.6"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </span>
  <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="mb-4 flex items-center gap-3">
          <!--
            One mark, every ground. The light alternate was retired upstream:
            on the forest band the tile recedes and the mint square with its
            lemon diamond carries the monogram on its own.
          -->
          <img src="/assets/logos/zippyzack-mark.svg" alt="" width="36" height="36" class="h-9 w-9" />
          <span class="font-display text-xl font-extrabold tracking-tight text-cream">
            Zippy<span class="text-lemon">Zack</span><span class="text-cream/70">.com</span>
          </span>
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-cream/75">
          Quality yarn kits and crochet tools for every project. Everything you need to create,
          bundled with care.
        </p>
        <div class="mt-6 flex items-center gap-4">
          {
            socials.map((social) => (
              <a
                href="#"
                aria-label={social.label}
                class="flex h-9 w-9 items-center justify-center rounded-pill bg-cream/10 text-cream transition-all duration-fast ease-out hover:-translate-y-0.5 hover:bg-mint hover:text-ink"
              >
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d={social.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="mb-4 font-display text-base font-bold text-cream">Explore</h4>
        <ul class="space-y-2.5">
          {
            exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-cream/75 transition-colors duration-fast ease-out hover:text-mint"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Info -->
      <div>
        <h4 class="mb-4 font-display text-base font-bold text-cream">Info</h4>
        <ul class="space-y-2.5">
          {
            infoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-cream/75 transition-colors duration-fast ease-out hover:text-mint"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-cream/[0.18] pt-8 sm:flex-row"
    >
      <p class="text-xs text-cream/75">
        &copy; {new Date().getFullYear()} ZippyZack.com. All rights reserved. Made with <span
          class="text-lemon">♥</span
        > and yarn.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="/privacy"
          class="text-xs text-cream/75 transition-colors duration-fast ease-out hover:text-mint"
          >Privacy Policy</a
        >
        <a
          href="/terms"
          class="text-xs text-cream/75 transition-colors duration-fast ease-out hover:text-mint"
          >Terms</a
        >
      </div>
    </div>
  </div>
</footer>
