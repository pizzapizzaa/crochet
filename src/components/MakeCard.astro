---
import type { MakeWithBundle } from '../lib/database.types';
import { difficultyBadge, money, priceBundle } from '../lib/makes';
import { ON_IMG_ERROR, productImage } from '../lib/images';

export interface Props {
  make: MakeWithBundle;
  class?: string;
}

const { make, class: className = '' } = Astro.props;
const pricing = priceBundle(make, make.items);
const image = productImage(make.image_url);
---

<!--
  Same card grammar as ProductCard — paper fill, cream hairline, lift on hover —
  but the credit line is fixed to the bottom of the photo, because it travels
  with the image everywhere the image goes.
-->
<article
  class={`group flex flex-col overflow-hidden rounded-card border border-cream-300 bg-paper shadow-sm transition-all duration-base ease-out hover:-translate-y-0.5 hover:shadow-lg ${className}`}
>
  <a href={`/makes/${make.slug}`} class="relative block aspect-[4/3] overflow-hidden bg-cream-200">
    <img
      src={image}
      onerror={ON_IMG_ERROR}
      alt={make.title}
      class="h-full w-full object-cover transition-transform duration-lazy ease-out group-hover:scale-[1.04]"
      loading="lazy"
    />
    <div class="absolute inset-x-0 bottom-0 bg-photo-scrim px-3 pb-2 pt-8">
      <p class="truncate text-[11px] font-semibold text-cream">
        Pin by {make.author_name}
      </p>
    </div>
    {
      make.difficulty && (
        <span
          class={`absolute left-3 top-3 rounded-pill px-2.5 py-1 text-micro font-bold uppercase tracking-wide shadow-sm ${difficultyBadge(make.difficulty)}`}
        >
          {make.difficulty}
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col gap-1.5 p-5">
    <p class="text-micro font-bold uppercase tracking-eyebrow text-ink-muted">
      {pricing.required.length} item{pricing.required.length === 1 ? '' : 's'} to make it
    </p>
    <h3 class="font-display text-lg font-bold leading-snug text-ink">
      <a
        href={`/makes/${make.slug}`}
        class="text-inherit no-underline transition-colors duration-fast ease-out hover:text-mint-deep"
      >
        {make.title}
      </a>
    </h3>
    {make.summary && <p class="line-clamp-2 text-xs text-ink-muted">{make.summary}</p>}

    <div class="mt-auto flex items-end justify-between gap-3 pt-4">
      <div>
        <p class="text-micro font-bold uppercase tracking-eyebrow text-ink-muted">Bundle</p>
        <div class="flex items-baseline gap-2">
          <span class="font-display text-lg font-extrabold text-ink">
            {money(pricing.bundlePrice)}
          </span>
          {
            pricing.savings > 0 && (
              <span class="text-sm text-ink-muted line-through">{money(pricing.itemsSubtotal)}</span>
            )
          }
        </div>
      </div>
      <a
        href={`/makes/${make.slug}`}
        class="shrink-0 rounded-pill bg-btn-gradient px-4 py-2.5 text-xs font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105 active:scale-[.97]"
      >
        See what you need
      </a>
    </div>
  </div>
</article>
