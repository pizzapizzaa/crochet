---
import type { Product } from '../lib/database.types';

export interface Props {
  product: Product;
  class?: string;
}

const { product, class: className = '' } = Astro.props;
const primaryImage = product.images?.[0] ?? '/placeholder-product.jpg';
const discount = product.compare_at_price
  ? Math.round(((product.compare_at_price - product.price) / product.compare_at_price) * 100)
  : null;
const isSoldOut = product.stock === 0;
const isLowStock = product.stock > 0 && product.stock <= 3;

// Craft specifics are the trust signal — middot separator is part of the voice.
const spec = product.yarn_weight
  ? `${product.yarn_weight} weight · Hook ${product.hook_size}`
  : product.dimensions;
---

<!--
  Paper fill, 1px cream hairline, 16px radius, shadow-sm at rest. Hover lifts
  -2px to shadow-lg and zooms the photo to 1.04 over 600ms. No coloured border.
-->
<article
  class={`group flex flex-col overflow-hidden rounded-card border border-cream-300 bg-paper shadow-sm transition-all duration-base ease-out hover:-translate-y-0.5 hover:shadow-lg ${className}`}
>
  <a
    href={`/store/${product.slug}`}
    class="relative block aspect-square overflow-hidden bg-cream-200"
  >
    <img
      src={primaryImage}
      alt={product.name}
      class="h-full w-full object-cover transition-transform duration-lazy ease-out group-hover:scale-[1.04]"
      loading="lazy"
    />
    {
      discount && (
        <span class="absolute left-3 top-3 rounded-pill bg-lemon px-2.5 py-1 text-micro font-bold uppercase tracking-wide text-ink">
          -{discount}%
        </span>
      )
    }
    {
      isSoldOut ? (
        <span class="absolute right-3 top-3 rounded-pill bg-forest-deep/80 px-2.5 py-1 text-micro font-bold uppercase tracking-wide text-cream">
          Sold out
        </span>
      ) : isLowStock ? (
        <span class="absolute right-3 top-3 rounded-pill bg-lemon-deep px-2.5 py-1 text-micro font-bold uppercase tracking-wide text-cream">
          Only {product.stock} left
        </span>
      ) : null
    }
  </a>

  <div class="flex flex-1 flex-col gap-1.5 p-5">
    <p class="text-micro font-bold uppercase tracking-eyebrow text-ink-muted">
      {product.category}
    </p>
    <h3 class="font-display text-lg font-bold leading-snug text-ink">
      <a
        href={`/store/${product.slug}`}
        class="text-inherit no-underline transition-colors duration-fast ease-out hover:text-mint-deep"
      >
        {product.name}
      </a>
    </h3>
    {spec && <p class="text-xs text-ink-muted">{spec}</p>}

    <div class="mt-auto flex items-center justify-between gap-3 pt-4">
      <div class="flex items-baseline gap-2">
        <span class="font-display text-lg font-extrabold text-ink">
          ${product.price.toFixed(2)}
        </span>
        {
          product.compare_at_price && (
            <span class="text-sm text-ink-muted line-through">
              ${product.compare_at_price.toFixed(2)}
            </span>
          )
        }
      </div>
      <a
        href={`/store/${product.slug}`}
        class={`shrink-0 rounded-pill px-4 py-2.5 text-xs font-bold transition-all duration-fast ease-out ${
          isSoldOut
            ? 'bg-cream-200 text-ink-muted'
            : 'bg-btn-gradient text-ink shadow-sm hover:-translate-y-0.5 hover:brightness-105 active:scale-[.97]'
        }`}
      >
        {isSoldOut ? 'Sold out' : 'View Details'}
      </a>
    </div>
  </div>
</article>
