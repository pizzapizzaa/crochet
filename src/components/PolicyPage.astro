---
/*
 * The shell every policy page sits in.
 *
 * These four pages — shipping, care, privacy, terms — are the ones linked from
 * the footer and read only when something has gone wrong or a decision is being
 * made. That argues for one shape rather than four: the same header, the same
 * measure, the same place the last-updated date sits, so a reader who has found
 * their way to one can find the same thing on the next.
 *
 * Everything inside the slot is plain prose. `.policy` below styles the tags
 * directly rather than asking each page to carry a class on every heading,
 * because a policy page that is tedious to edit is a policy page that goes
 * stale.
 */
import Layout from '../layouts/Layout.astro';

export interface Props {
  title: string;
  description: string;
  eyebrow: string;
  /** The one-sentence version, before the detail. */
  intro: string;
  /** ISO date this page's terms last actually changed. */
  updated: string;
}

const { title, description, eyebrow, intro, updated } = Astro.props;

const updatedLabel = new Date(updated).toLocaleDateString('en-US', { dateStyle: 'long' });
---

<Layout title={title} description={description}>
  <section class="border-b border-cream-300 bg-hero-wash py-12">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <nav class="mb-2 flex items-center gap-1.5 text-xs text-ink-muted">
        <a href="/" class="transition-colors duration-fast ease-out hover:text-mint-deep">Home</a>
        <span>/</span>
        <span class="text-ink-body">{title}</span>
      </nav>
      <p class="text-micro font-bold uppercase tracking-eyebrow text-mint-deep">{eyebrow}</p>
      <h1 class="mt-1.5 font-display text-display-2 font-extrabold text-ink">{title}</h1>
      <p class="mt-3 max-w-2xl text-ink-body">{intro}</p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <article class="policy">
      <slot />
    </article>

    <footer class="mt-12 border-t border-cream-300 pt-6">
      <p class="text-xs text-ink-muted">Last updated {updatedLabel}.</p>
      <p class="mt-1 text-sm text-ink-muted">
        Anything here unclear? <a href="/contact">Ask me</a> — a policy nobody understands is not
        doing its job.
      </p>
    </footer>
  </div>
</Layout>

<style is:global>
  /*
   * Scoped to .policy so this cannot leak into the rest of the site. The
   * measure is already held by the container; what these rules do is rhythm —
   * enough air between a heading and the paragraph it belongs to that the
   * page can be skimmed for the one clause somebody actually came for.
   */
  .policy h2 {
    font-family: "Baloo 2", ui-rounded, system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ink);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .policy h2:first-child {
    margin-top: 0;
  }

  .policy h3 {
    font-family: "Baloo 2", ui-rounded, system-ui, sans-serif;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--ink);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .policy p {
    color: var(--ink-body);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .policy ul,
  .policy ol {
    margin: 0 0 1.25rem 0;
    padding-left: 1.25rem;
    color: var(--ink-body);
    line-height: 1.7;
  }

  .policy ul {
    list-style: disc;
  }

  .policy ol {
    list-style: decimal;
  }

  .policy li {
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .policy strong {
    font-weight: 700;
    color: var(--ink);
  }

  .policy a {
    font-weight: 700;
    color: var(--mint-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .policy a:hover {
    color: var(--ink);
  }

  /* A pulled-out fact — a price, a window, a number that answers the question. */
  .policy .callout {
    border: 1px solid var(--cream-300);
    background: var(--paper);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .policy .callout p:last-child {
    margin-bottom: 0;
  }

  .policy table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.9375rem;
  }

  .policy th {
    text-align: left;
    font-family: "Baloo 2", ui-rounded, system-ui, sans-serif;
    font-weight: 700;
    color: var(--ink);
    border-bottom: 2px solid var(--cream-300);
    padding: 0.5rem 0.75rem 0.5rem 0;
  }

  .policy td {
    color: var(--ink-body);
    border-bottom: 1px solid var(--cream-300);
    padding: 0.625rem 0.75rem 0.625rem 0;
    vertical-align: top;
  }
</style>
