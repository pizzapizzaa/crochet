---
/*
 * The basket, as a slide-over. Rendered once in Layout.astro so every page has
 * it, and opened by the header button or by `window.dispatchEvent(new Event('cart:open'))`
 * — which is what an Add to Cart button fires once it has stashed its line.
 *
 * Rows are drawn twice: straight away from localStorage so the panel is never
 * blank, then again from /api/shop/cart-price, which is the figure that counts.
 */
---

<div id="cart-drawer" class="pointer-events-none fixed inset-0 z-[60] hidden">
  <div
    id="cart-scrim"
    class="absolute inset-0 bg-ink/35 opacity-0 transition-opacity duration-base ease-out"
  >
  </div>

  <aside
    id="cart-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
    class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col bg-cream-100 shadow-lg transition-transform duration-base ease-out"
  >
    <header class="flex items-center justify-between border-b border-cream-300 bg-paper px-5 py-4">
      <h2 id="cart-drawer-title" class="font-display text-lg font-extrabold text-ink">
        Your basket
      </h2>
      <button
        type="button"
        id="cart-close"
        aria-label="Close basket"
        class="rounded-field p-2 text-ink-body transition-colors duration-fast ease-out hover:bg-cream-200"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </header>

    <div id="cart-body" class="flex-1 overflow-y-auto px-5 py-4">
      <div id="cart-problems"></div>
      <ul id="cart-lines" class="divide-y divide-cream-300"></ul>

      <div id="cart-empty" class="hidden px-2 py-16 text-center">
        <p class="text-4xl">🧺</p>
        <h3 class="mt-3 font-display text-lg font-bold text-ink">Nothing in here yet</h3>
        <p class="mt-1 text-sm text-ink-muted">
          Pick out some yarn and it will show up right here.
        </p>
        <a
          href="/store"
          class="mt-5 inline-block rounded-pill bg-btn-gradient px-6 py-2.5 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105"
        >
          Browse the shop
        </a>
      </div>
    </div>

    <footer id="cart-foot" class="border-t border-cream-300 bg-paper px-5 py-4">
      <dl class="space-y-1.5 text-sm">
        <div class="flex justify-between">
          <dt class="text-ink-muted">Subtotal</dt>
          <dd class="font-semibold text-ink-body" data-subtotal>—</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-ink-muted">Shipping</dt>
          <dd class="font-semibold text-ink-body" data-shipping>—</dd>
        </div>
        <div class="flex justify-between border-t border-cream-300 pt-1.5">
          <dt class="font-display font-bold text-ink">Total</dt>
          <dd class="font-display text-lg font-extrabold text-ink" data-total>—</dd>
        </div>
      </dl>

      <a
        href="/checkout"
        id="cart-checkout"
        class="mt-4 block rounded-pill bg-btn-gradient px-6 py-3 text-center text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105"
      >
        Checkout
      </a>
      <a
        href="/cart"
        class="mt-2 block py-2 text-center text-xs font-bold text-ink-muted transition-colors duration-fast ease-out hover:text-mint-deep"
      >
        View the full basket
      </a>
    </footer>
  </aside>
</div>

<script>
  import { CART_EVENT, readCart, removeLine, setQty, type LineKind } from '../lib/cart';
  import {
    EMPTY,
    fetchPricing,
    lineRow,
    money,
    problemBanner,
    type PricedCartView,
  } from '../lib/cartView';

  const drawer = document.getElementById('cart-drawer')!;
  const scrim = document.getElementById('cart-scrim')!;
  const panel = document.getElementById('cart-panel')!;
  const linesEl = document.getElementById('cart-lines')!;
  const problemsEl = document.getElementById('cart-problems')!;
  const emptyEl = document.getElementById('cart-empty')!;
  const footEl = document.getElementById('cart-foot')!;

  let lastFocused: HTMLElement | null = null;

  function open() {
    lastFocused = document.activeElement as HTMLElement;
    drawer.classList.remove('hidden');
    drawer.classList.add('pointer-events-auto');
    // One frame of the closed position first, or the transition has nothing to
    // animate from and the panel simply appears.
    requestAnimationFrame(() => {
      scrim.classList.replace('opacity-0', 'opacity-100');
      panel.classList.remove('translate-x-full');
    });
    document.body.style.overflow = 'hidden';
    document.getElementById('cart-close')?.focus();
    render();
  }

  function close() {
    scrim.classList.replace('opacity-100', 'opacity-0');
    panel.classList.add('translate-x-full');
    document.body.style.overflow = '';
    window.setTimeout(() => {
      drawer.classList.add('hidden');
      drawer.classList.remove('pointer-events-auto');
    }, 220);
    lastFocused?.focus();
  }

  async function render() {
    const lines = readCart();

    if (lines.length === 0) {
      linesEl.innerHTML = '';
      problemsEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      footEl.classList.add('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    footEl.classList.remove('hidden');

    // Rows from the snapshot first so the panel is never blank while the
    // server is asked. The totals stay dashed until that answer lands — a
    // figure added up from localStorage is not one worth showing.
    paint(
      {
        ...EMPTY,
        lines: lines.map((l) => ({
          kind: l.kind,
          id: l.id,
          name: l.snap.name,
          href: l.snap.href,
          image: l.snap.image,
          unitPrice: l.snap.price,
          qty: l.qty,
          lineTotal: l.snap.price * l.qty,
          compareAt: null,
        })),
      },
      false,
    );

    const priced = await fetchPricing(lines);
    if (priced) paint(priced, true);
  }

  function paint(priced: PricedCartView, totalsAreReal: boolean) {
    linesEl.innerHTML = priced.lines.map((l) => lineRow(l, true)).join('');
    problemsEl.innerHTML = problemBanner(priced.problems);

    const set = (key: string, value: string) => {
      const el = footEl.querySelector(`[data-${key}]`);
      if (el) el.textContent = value;
    };
    set('subtotal', totalsAreReal ? money(priced.subtotal) : '—');
    set('shipping', totalsAreReal ? (priced.shipping === 0 ? 'Free' : money(priced.shipping)) : '—');
    set('total', totalsAreReal ? money(priced.total) : '—');
  }

  linesEl.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest('button');
    if (!target) return;

    const row = target.closest('li');
    const kind = row?.dataset.kind as LineKind | undefined;
    const id = row?.dataset.id;
    if (!kind || !id) return;

    if (target.hasAttribute('data-remove')) {
      removeLine(kind, id);
      return;
    }

    const step = Number(target.dataset.step ?? 0);
    if (!step) return;
    const current = Number(row?.querySelector('[data-qty]')?.textContent ?? 1);
    setQty(kind, id, current + step);
  });

  document.getElementById('cart-close')?.addEventListener('click', close);
  scrim.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer.classList.contains('hidden')) close();
  });

  window.addEventListener('cart:open', open);
  window.addEventListener(CART_EVENT, () => {
    if (!drawer.classList.contains('hidden')) render();
  });
</script>
