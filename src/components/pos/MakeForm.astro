---
import type { MakeWithBundle, Product } from '../../lib/database.types';
import { DIFFICULTIES } from '../../lib/database.types';
import { priceBundle } from '../../lib/makes';

/*
 * One form for both create and edit — /api/pos/make-save branches on whether
 * an `id` came through.
 *
 * The bundle rows submit as parallel arrays (item_product_id[], item_quantity[]
 * …). Every row control is an input or a select, never a checkbox: an unticked
 * checkbox is simply absent from the submission, which would shift every array
 * after it by one and quietly re-assign quantities to the wrong products.
 */
export interface Props {
  make?: MakeWithBundle | null;
  products: Product[];
  next?: string;
}

const { make = null, products, next = '/pos/makes' } = Astro.props;
const isEdit = Boolean(make);
const items = make?.items ?? [];

// Server-side preview so the panel is right on first paint, before the script
// that keeps it live has run.
const initial = make
  ? priceBundle(make, items)
  : { itemsSubtotal: 0, bundlePrice: 0, savings: 0, savingsPct: 0, optionalSubtotal: 0 };

// Everything the client needs to price a bundle without another round trip.
const productData = products.map((p) => ({
  id: p.id,
  name: p.name,
  price: Number(p.price),
  cost: p.cost_price === null ? null : Number(p.cost_price),
  category: p.category,
  stock: p.stock,
  active: p.is_active,
}));

const field =
  'w-full rounded-field border border-cream-300 bg-cream-50 px-3.5 py-2.5 text-sm text-ink placeholder-ink-faint focus:border-mint-mid focus:outline-none focus:ring-2 focus:ring-mint/40';
const smallField =
  'w-full rounded-field border border-cream-300 bg-cream-50 px-2.5 py-2 text-sm text-ink placeholder-ink-faint focus:border-mint-mid focus:outline-none focus:ring-2 focus:ring-mint/40';
const label = 'mb-1.5 block text-micro font-bold uppercase tracking-eyebrow text-ink-muted';
const card = 'rounded-card border border-cream-300 bg-paper p-5 shadow-sm';

// Grouped so a long catalogue is still navigable in a plain <select>.
const grouped = [...new Set(products.map((p) => p.category))].sort().map((category) => ({
  category,
  options: products.filter((p) => p.category === category),
}));
---

<form method="POST" action="/api/pos/make-save" class="grid gap-5 lg:grid-cols-3">
  <input type="hidden" name="next" value={next} />
  {isEdit && <input type="hidden" name="id" value={make!.id} />}

  <!-- Main column -->
  <div class="space-y-5 lg:col-span-2">
    <!-- ── Source ─────────────────────────────────────────────────── -->
    <div class={card}>
      <h2 class="font-display text-lg font-bold text-ink">The pin</h2>
      <p class="mb-4 mt-0.5 text-xs text-ink-muted">
        Paste the Pinterest link and pull the image and the author across. We link back to the pin
        rather than reproducing the pattern, and the author travels with the make.
      </p>

      <div class="space-y-4">
        <div>
          <label class={label} for="pinterest_url">Pinterest link *</label>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input
              id="pinterest_url"
              name="pinterest_url"
              type="url"
              required
              value={make?.pinterest_url ?? ''}
              placeholder="https://www.pinterest.com/pin/1234567890/"
              class={`${field} flex-1`}
            />
            <button
              type="button"
              id="fetch-pin"
              class="shrink-0 rounded-pill bg-btn-gradient px-5 py-2.5 text-sm font-bold text-ink shadow-sm transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105 active:scale-[.98]"
            >
              Fetch from Pinterest
            </button>
          </div>
          <p id="pin-status" class="mt-1.5 text-xs font-semibold text-ink-muted"></p>
        </div>

        <div class="grid gap-4 sm:grid-cols-[160px_1fr]">
          <!-- Pin image preview -->
          <div>
            <span class={label}>Image</span>
            <div
              id="pin-preview"
              class="flex aspect-square items-center justify-center overflow-hidden rounded-field border border-cream-300 bg-cream-100 text-center text-[11px] text-ink-faint"
            >
              {
                make?.image_url ? (
                  <img src={make.image_url} alt="" class="h-full w-full object-cover" />
                ) : (
                  <span class="px-2">No image yet</span>
                )
              }
            </div>
          </div>

          <div class="space-y-4">
            <div>
              <label class={label} for="image_url">Image URL</label>
              <textarea
                id="image_url"
                name="image_url"
                rows="2"
                placeholder="Filled in by Fetch — or paste/upload your own"
                class={`${field} font-mono text-xs`}>{make?.image_url ?? ''}</textarea>
              <div class="mt-2 flex flex-wrap items-center gap-3">
                <label
                  for="make-image-upload"
                  class="cursor-pointer rounded-pill border border-cream-300 bg-cream-100 px-4 py-2 text-xs font-bold text-ink transition-colors duration-fast ease-out hover:bg-cream-200"
                >
                  Upload instead
                </label>
                <input id="make-image-upload" type="file" accept="image/*" class="hidden" />
                <span id="make-upload-status" class="text-xs font-semibold text-ink-muted"></span>
              </div>
            </div>

            <input
              type="hidden"
              id="source_image_url"
              name="source_image_url"
              value={make?.source_image_url ?? ''}
            />

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class={label} for="author_name">Pin author *</label>
                <input
                  id="author_name"
                  name="author_name"
                  type="text"
                  required
                  maxlength="120"
                  value={make?.author_name ?? ''}
                  placeholder="Who made the original"
                  class={field}
                />
              </div>
              <div>
                <label class={label} for="author_url">Author profile</label>
                <input
                  id="author_url"
                  name="author_url"
                  type="url"
                  value={make?.author_url ?? ''}
                  placeholder="https://www.pinterest.com/theirhandle/"
                  class={field}
                />
              </div>
            </div>

            <div>
              <label class={label} for="attribution_note">Credit / licence note</label>
              <input
                id="attribution_note"
                name="attribution_note"
                type="text"
                maxlength="200"
                value={make?.attribution_note ?? ''}
                placeholder="Pattern © the original designer — shown with a link, not reproduced"
                class={field}
              />
              <p class="mt-1.5 text-xs text-ink-faint">
                Printed under the credit line on the public page.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── About ──────────────────────────────────────────────────── -->
    <div class={card}>
      <h2 class="mb-4 font-display text-lg font-bold text-ink">About this make</h2>

      <div class="space-y-4">
        <div>
          <label class={label} for="title">Title *</label>
          <input
            id="title"
            name="title"
            type="text"
            required
            maxlength="140"
            value={make?.title ?? ''}
            placeholder="Chunky granny square tote"
            class={field}
          />
        </div>

        <div>
          <label class={label} for="slug">URL slug</label>
          <div class="flex items-center gap-2">
            <span class="shrink-0 font-mono text-xs text-ink-faint">/makes/</span>
            <input
              id="slug"
              name="slug"
              type="text"
              maxlength="80"
              value={make?.slug ?? ''}
              placeholder="left blank, generated from the title"
              pattern="[a-z0-9\-]*"
              class={`${field} font-mono`}
            />
          </div>
        </div>

        <div>
          <label class={label} for="summary">Summary</label>
          <textarea
            id="summary"
            name="summary"
            rows="4"
            placeholder="What it is and why this bundle makes it. Two or three sentences."
            class={field}>{make?.summary ?? ''}</textarea>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class={label} for="difficulty">Difficulty</label>
            <select id="difficulty" name="difficulty" class={field}>
              <option value="">Not set</option>
              {
                DIFFICULTIES.map((d) => (
                  <option value={d} selected={make?.difficulty === d}>
                    {d}
                  </option>
                ))
              }
            </select>
          </div>
          <div>
            <label class={label} for="estimated_time">Time to make</label>
            <input
              id="estimated_time"
              name="estimated_time"
              type="text"
              value={make?.estimated_time ?? ''}
              placeholder="A weekend"
              class={field}
            />
          </div>
        </div>

        <div>
          <label class={label} for="tags">Tags</label>
          <input
            id="tags"
            name="tags"
            type="text"
            value={make?.tags?.join(', ') ?? ''}
            placeholder="granny square, tote, beginner friendly"
            class={field}
          />
          <p class="mt-1.5 text-xs text-ink-faint">Comma separated.</p>
        </div>
      </div>
    </div>

    <!-- ── Bundle ─────────────────────────────────────────────────── -->
    <div class={card}>
      <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-display text-lg font-bold text-ink">The bundle</h2>
        <span class="rounded-pill bg-cream-100 px-3 py-1 text-xs font-bold text-ink-muted">
          What we actually sell
        </span>
      </div>
      <p class="mb-4 text-xs text-ink-muted">
        The yarn and tools someone needs to make this. Every line is a product from the shop, so its
        price and stock stay in one place.
      </p>

      {
        products.length === 0 ? (
          <p class="rounded-field bg-lemon-wash px-3 py-2.5 text-xs font-semibold text-lemon-deep">
            There are no products to bundle yet —{' '}
            <a href="/pos/products/new" class="underline">
              add some yarn and tools first
            </a>
            .
          </p>
        ) : (
          <>
            <div class="hidden gap-2 px-1 pb-2 text-micro font-bold uppercase tracking-eyebrow text-ink-muted sm:grid sm:grid-cols-[1fr_84px_1fr_120px_84px]">
              <span>Material</span>
              <span>Qty</span>
              <span>Note</span>
              <span>Required?</span>
              <span class="text-right">Line</span>
            </div>

            <div id="bundle-rows" class="space-y-2">
              {items.map((item) => (
                <div class="bundle-row grid gap-2 rounded-field bg-cream-50 p-2.5 sm:grid-cols-[1fr_84px_1fr_120px_84px] sm:items-center">
                  <select name="item_product_id" class={`${smallField} row-product`}>
                    <option value="">Remove this line…</option>
                    {grouped.map((g) => (
                      <optgroup label={g.category}>
                        {g.options.map((p) => (
                          <option value={p.id} selected={p.id === item.product_id}>
                            {p.name}
                            {p.is_active ? '' : ' (draft)'}
                          </option>
                        ))}
                      </optgroup>
                    ))}
                  </select>
                  <input
                    name="item_quantity"
                    type="number"
                    min="0.25"
                    step="0.25"
                    value={item.quantity}
                    class={`${smallField} row-qty`}
                  />
                  <input
                    name="item_note"
                    type="text"
                    value={item.note ?? ''}
                    placeholder="Colour A"
                    class={`${smallField} row-note`}
                  />
                  <select name="item_optional" class={`${smallField} row-optional`}>
                    <option value="required" selected={!item.is_optional}>
                      Required
                    </option>
                    <option value="optional" selected={item.is_optional}>
                      Optional
                    </option>
                  </select>
                  <div class="flex items-center justify-between gap-2 sm:justify-end">
                    <span class="row-total font-display text-sm font-extrabold text-ink">—</span>
                    <button
                      type="button"
                      class="row-remove rounded-field px-2 py-1 text-xs font-bold text-lemon-deep transition-colors duration-fast ease-out hover:bg-lemon-wash"
                      aria-label="Remove this material"
                    >
                      ✕
                    </button>
                  </div>
                </div>
              ))}
            </div>

            <button
              type="button"
              id="add-row"
              class="mt-3 rounded-pill border border-cream-300 bg-cream-100 px-4 py-2 text-xs font-bold text-ink transition-colors duration-fast ease-out hover:bg-cream-200"
            >
              + Add a material
            </button>

            <p id="bundle-empty" class="mt-3 hidden text-xs font-semibold text-lemon-deep">
              An empty bundle means the public page has nothing to sell.
            </p>

            {/* Inert until cloned — controls inside a template are never submitted. */}
            <template id="bundle-row-template">
              <div class="bundle-row grid gap-2 rounded-field bg-cream-50 p-2.5 sm:grid-cols-[1fr_84px_1fr_120px_84px] sm:items-center">
                <select name="item_product_id" class={`${smallField} row-product`}>
                  <option value="">Choose a material…</option>
                  {grouped.map((g) => (
                    <optgroup label={g.category}>
                      {g.options.map((p) => (
                        <option value={p.id}>
                          {p.name}
                          {p.is_active ? '' : ' (draft)'}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <input
                  name="item_quantity"
                  type="number"
                  min="0.25"
                  step="0.25"
                  value="1"
                  class={`${smallField} row-qty`}
                />
                <input name="item_note" type="text" placeholder="Colour A" class={`${smallField} row-note`} />
                <select name="item_optional" class={`${smallField} row-optional`}>
                  <option value="required">Required</option>
                  <option value="optional">Optional</option>
                </select>
                <div class="flex items-center justify-between gap-2 sm:justify-end">
                  <span class="row-total font-display text-sm font-extrabold text-ink">—</span>
                  <button
                    type="button"
                    class="row-remove rounded-field px-2 py-1 text-xs font-bold text-lemon-deep transition-colors duration-fast ease-out hover:bg-lemon-wash"
                    aria-label="Remove this material"
                  >
                    ✕
                  </button>
                </div>
              </div>
            </template>
          </>
        )
      }
    </div>
  </div>

  <!-- Side column -->
  <div class="space-y-5">
    <div class={card}>
      <h2 class="mb-4 font-display text-lg font-bold text-ink">Visibility</h2>

      <div class="space-y-3">
        <label class="flex cursor-pointer items-start gap-3 rounded-field bg-cream-50 p-3">
          <input
            type="checkbox"
            name="is_active"
            value="true"
            checked={make ? make.is_active : true}
            class="mt-0.5 h-4 w-4 shrink-0 accent-[#00695C]"
          />
          <span>
            <span class="block text-sm font-bold text-ink">Live in the shop</span>
            <span class="block text-xs text-ink-muted">Uncheck to keep it as a draft.</span>
          </span>
        </label>

        <label class="flex cursor-pointer items-start gap-3 rounded-field bg-cream-50 p-3">
          <input
            type="checkbox"
            name="is_featured"
            value="true"
            checked={make?.is_featured ?? false}
            class="mt-0.5 h-4 w-4 shrink-0 accent-[#00695C]"
          />
          <span>
            <span class="block text-sm font-bold text-ink">Featured</span>
            <span class="block text-xs text-ink-muted">Sorts first on the makes page.</span>
          </span>
        </label>

        <div>
          <label class={label} for="display_order">Display order</label>
          <input
            id="display_order"
            name="display_order"
            type="number"
            step="1"
            value={make?.display_order ?? 0}
            class={field}
          />
        </div>
      </div>
    </div>

    <!-- ── Pricing ────────────────────────────────────────────────── -->
    <div class={card}>
      <h2 class="font-display text-lg font-bold text-ink">Bundle price</h2>
      <p class="mb-4 mt-0.5 text-xs text-ink-muted">
        Leave the override blank and the bundle is the sum of its required items, less the discount.
      </p>

      <div class="space-y-4">
        <div class="space-y-2 rounded-field bg-cream-50 p-3.5 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-ink-muted">Items separately</span>
            <span id="pv-subtotal" class="font-display font-bold text-ink">
              ${initial.itemsSubtotal.toFixed(2)}
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-ink-muted">Bundle price</span>
            <span id="pv-bundle" class="font-display text-lg font-extrabold text-ink">
              ${initial.bundlePrice.toFixed(2)}
            </span>
          </div>
          <div class="flex items-center justify-between border-t border-cream-300 pt-2">
            <span class="text-ink-muted">They save</span>
            <span id="pv-savings" class="font-display font-bold text-mint-deep">
              ${initial.savings.toFixed(2)}
            </span>
          </div>
          <div id="pv-optional-row" class="flex items-center justify-between text-xs">
            <span class="text-ink-faint">Optional extras</span>
            <span id="pv-optional" class="font-bold text-ink-muted">
              ${initial.optionalSubtotal.toFixed(2)}
            </span>
          </div>
          <div id="pv-margin-row" class="flex items-center justify-between border-t border-cream-300 pt-2 text-xs">
            <span class="text-ink-faint">Margin on the bundle</span>
            <span id="pv-margin" class="font-bold text-ink-muted">—</span>
          </div>
        </div>

        <div>
          <label class={label} for="bundle_discount_pct">Bundle discount</label>
          <div class="relative">
            <input
              id="bundle_discount_pct"
              name="bundle_discount_pct"
              type="number"
              min="0"
              max="99"
              step="0.5"
              value={make?.bundle_discount_pct ?? 0}
              class={`${field} pr-8`}
            />
            <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-ink-faint">%</span>
          </div>
          <p class="mt-1.5 text-xs text-ink-faint">Off the total when they buy the whole bundle.</p>
        </div>

        <div>
          <label class={label} for="bundle_price">Fixed price (override)</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-ink-faint">$</span>
            <input
              id="bundle_price"
              name="bundle_price"
              type="number"
              min="0"
              step="0.01"
              value={make?.bundle_price !== null && make?.bundle_price !== undefined
                ? Number(make.bundle_price).toFixed(2)
                : ''}
              placeholder="blank = calculated"
              class={`${field} pl-7`}
            />
          </div>
          <p id="override-note" class="mt-1.5 hidden text-xs font-semibold text-lemon-deep">
            A fixed price ignores the discount above.
          </p>
        </div>
      </div>
    </div>

    <div class="sticky bottom-4 space-y-2">
      <button
        type="submit"
        class="w-full rounded-pill bg-btn-gradient py-3 text-sm font-bold text-ink shadow transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105 active:scale-[.98]"
      >
        {isEdit ? 'Save make' : 'Create make'}
      </button>
      <a
        href="/pos/makes"
        class="block w-full rounded-pill border border-cream-300 bg-paper py-3 text-center text-sm font-bold text-ink-body transition-colors duration-fast ease-out hover:bg-cream-100"
      >
        Cancel
      </a>
    </div>
  </div>

  <script type="application/json" id="product-data" set:html={JSON.stringify(productData)} />
</form>

<script>
  interface ProductRow {
    id: string;
    name: string;
    price: number;
    cost: number | null;
    category: string;
    stock: number;
    active: boolean;
  }

  const dataEl = document.getElementById('product-data');
  const PRODUCTS: ProductRow[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const BY_ID = new Map(PRODUCTS.map((p) => [p.id, p]));

  const money = (n: number) =>
    '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  // ── Slug suggestion ──────────────────────────────────────────────
  const titleInput = $<HTMLInputElement>('title');
  const slugInput = $<HTMLInputElement>('slug');
  let slugTouched = Boolean(slugInput?.value);

  slugInput?.addEventListener('input', () => {
    slugTouched = true;
  });

  function suggestSlug() {
    if (slugTouched || !slugInput || !titleInput) return;
    slugInput.value = titleInput.value
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80);
  }

  titleInput?.addEventListener('input', suggestSlug);

  // ── Pinterest fetch ──────────────────────────────────────────────
  const pinInput = $<HTMLInputElement>('pinterest_url');
  const fetchBtn = $<HTMLButtonElement>('fetch-pin');
  const pinStatus = $<HTMLParagraphElement>('pin-status');
  const pinPreview = $<HTMLDivElement>('pin-preview');
  const imageField = $<HTMLTextAreaElement>('image_url');
  const sourceImageField = $<HTMLInputElement>('source_image_url');
  const authorNameInput = $<HTMLInputElement>('author_name');
  const authorUrlInput = $<HTMLInputElement>('author_url');
  const summaryInput = $<HTMLTextAreaElement>('summary');

  function say(message: string, tone: 'ok' | 'warn' | 'error' | 'muted' = 'muted') {
    if (!pinStatus) return;
    pinStatus.textContent = message;
    pinStatus.className =
      'mt-1.5 text-xs font-semibold ' +
      (tone === 'ok' ? 'text-mint-deep' : tone === 'error' || tone === 'warn' ? 'text-lemon-deep' : 'text-ink-muted');
  }

  function showImage(url: string) {
    if (!pinPreview) return;
    pinPreview.innerHTML = '';
    if (!url) {
      pinPreview.innerHTML = '<span class="px-2">No image yet</span>';
      return;
    }
    const img = document.createElement('img');
    img.src = url;
    img.alt = '';
    img.className = 'h-full w-full object-cover';
    img.onerror = () => {
      pinPreview.innerHTML = '<span class="px-2 text-lemon-deep">That image will not load</span>';
    };
    pinPreview.appendChild(img);
  }

  imageField?.addEventListener('input', () => showImage(imageField.value.trim()));

  async function fetchPin() {
    if (!pinInput || !fetchBtn) return;
    const url = pinInput.value.trim();
    if (!url) {
      say('Paste a Pinterest link first.', 'warn');
      return;
    }

    fetchBtn.disabled = true;
    fetchBtn.classList.add('opacity-60');
    say('Reading the pin…');

    try {
      const res = await fetch('/api/pos/pinterest-lookup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error ?? 'Lookup failed.');

      // Never overwrite something already typed — the fetch fills blanks.
      if (json.url) pinInput.value = json.url;
      if (json.imageUrl && imageField && !imageField.value.trim()) {
        imageField.value = json.imageUrl;
        showImage(json.imageUrl);
      }
      if (json.sourceImageUrl && sourceImageField) sourceImageField.value = json.sourceImageUrl;
      if (json.authorName && authorNameInput && !authorNameInput.value.trim()) {
        authorNameInput.value = json.authorName;
      }
      if (json.authorUrl && authorUrlInput && !authorUrlInput.value.trim()) {
        authorUrlInput.value = json.authorUrl;
      }
      if (json.title && titleInput && !titleInput.value.trim()) {
        titleInput.value = json.title;
        suggestSlug();
      }
      if (json.description && summaryInput && !summaryInput.value.trim()) {
        summaryInput.value = json.description;
      }

      if (json.note) {
        say(json.note, 'warn');
      } else {
        say(
          json.mirrored
            ? 'Pulled the pin in and kept our own copy of the image.'
            : 'Pulled the pin in.',
          'ok',
        );
      }
      if (!authorNameInput?.value.trim()) {
        say('Found the pin but not the author — type who made it before saving.', 'warn');
      }
    } catch (err) {
      say(err instanceof Error ? err.message : 'Lookup failed.', 'error');
    } finally {
      fetchBtn.disabled = false;
      fetchBtn.classList.remove('opacity-60');
    }
  }

  fetchBtn?.addEventListener('click', fetchPin);
  pinInput?.addEventListener('keydown', (e) => {
    // Enter in a lone URL field would submit the half-filled form otherwise.
    if (e.key === 'Enter') {
      e.preventDefault();
      fetchPin();
    }
  });

  // ── Image upload ─────────────────────────────────────────────────
  const uploadInput = $<HTMLInputElement>('make-image-upload');
  const uploadStatus = $<HTMLSpanElement>('make-upload-status');

  uploadInput?.addEventListener('change', async () => {
    const file = uploadInput.files?.[0];
    if (!file || !imageField) return;

    if (uploadStatus) uploadStatus.textContent = 'Uploading…';
    const body = new FormData();
    body.append('file', file);

    try {
      const res = await fetch('/api/pos/upload', { method: 'POST', body });
      const json = await res.json();
      if (!res.ok || !json.url) throw new Error(json.error ?? 'Upload failed');
      imageField.value = json.url;
      showImage(json.url);
      if (uploadStatus) uploadStatus.textContent = 'Image replaced.';
    } catch (err) {
      if (uploadStatus) {
        uploadStatus.textContent = err instanceof Error ? err.message : 'Upload failed';
      }
    } finally {
      uploadInput.value = '';
    }
  });

  // ── Bundle rows + live pricing ───────────────────────────────────
  const rowsHost = $<HTMLDivElement>('bundle-rows');
  const template = $<HTMLTemplateElement>('bundle-row-template');
  const addBtn = $<HTMLButtonElement>('add-row');
  const emptyNote = $<HTMLParagraphElement>('bundle-empty');
  const discountInput = $<HTMLInputElement>('bundle_discount_pct');
  const overrideInput = $<HTMLInputElement>('bundle_price');
  const overrideNote = $<HTMLParagraphElement>('override-note');

  function recalc() {
    if (!rowsHost) return;

    let subtotal = 0;
    let optionalTotal = 0;
    let cost = 0;
    let costKnown = true;
    let rowCount = 0;

    rowsHost.querySelectorAll<HTMLDivElement>('.bundle-row').forEach((row) => {
      const select = row.querySelector<HTMLSelectElement>('.row-product');
      const qtyInput = row.querySelector<HTMLInputElement>('.row-qty');
      const optionalSelect = row.querySelector<HTMLSelectElement>('.row-optional');
      const totalCell = row.querySelector<HTMLSpanElement>('.row-total');

      const product = select?.value ? BY_ID.get(select.value) : undefined;
      const quantity = Number(qtyInput?.value ?? '1');
      const isOptional = optionalSelect?.value === 'optional';

      if (!product || !Number.isFinite(quantity) || quantity <= 0) {
        if (totalCell) totalCell.textContent = '—';
        return;
      }

      rowCount += 1;
      const line = product.price * quantity;
      if (totalCell) totalCell.textContent = money(line);

      if (isOptional) {
        optionalTotal += line;
      } else {
        subtotal += line;
        if (product.cost === null) costKnown = false;
        else cost += product.cost * quantity;
      }
    });

    const discount = Number(discountInput?.value ?? '0') || 0;
    const overrideRaw = overrideInput?.value.trim() ?? '';
    const hasOverride = overrideRaw !== '' && Number.isFinite(Number(overrideRaw));
    const bundle = hasOverride ? Number(overrideRaw) : subtotal * (1 - discount / 100);
    const savings = Math.max(0, subtotal - bundle);

    const set = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    set('pv-subtotal', money(subtotal));
    set('pv-bundle', money(bundle));
    set('pv-savings', savings > 0 ? money(savings) + ' (' + ((savings / subtotal) * 100).toFixed(0) + '%)' : money(0));
    set('pv-optional', money(optionalTotal));
    set('pv-margin', costKnown && bundle > 0 ? (((bundle - cost) / bundle) * 100).toFixed(1) + '%' : 'costs missing');

    const optionalRow = $<HTMLDivElement>('pv-optional-row');
    if (optionalRow) optionalRow.classList.toggle('hidden', optionalTotal === 0);

    overrideNote?.classList.toggle('hidden', !(hasOverride && discount > 0));
    emptyNote?.classList.toggle('hidden', rowCount > 0);
  }

  function addRow() {
    if (!template || !rowsHost) return;
    const clone = template.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
    if (!clone) return;
    rowsHost.appendChild(clone);
    clone.querySelector<HTMLSelectElement>('.row-product')?.focus();
    recalc();
  }

  addBtn?.addEventListener('click', addRow);

  // Delegated so cloned rows work without rebinding.
  rowsHost?.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest('.row-remove');
    if (!button) return;
    button.closest('.bundle-row')?.remove();
    recalc();
  });
  rowsHost?.addEventListener('input', recalc);
  rowsHost?.addEventListener('change', recalc);
  discountInput?.addEventListener('input', recalc);
  overrideInput?.addEventListener('input', recalc);

  // Start a new make with one empty line rather than a bare "add" button.
  if (rowsHost && rowsHost.children.length === 0) addRow();
  recalc();
</script>
