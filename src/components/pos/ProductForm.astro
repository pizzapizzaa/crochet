---
import type { Category, Product } from '../../lib/database.types';

/*
 * One form for both create and edit — /api/pos/product-save branches on
 * whether an `id` came through. Plain form POST, no client framework: the
 * only JavaScript is the optional image uploader and the slug suggestion.
 */
export interface Props {
  product?: Product | null;
  categories: Category[];
  /** Where to send the browser after a successful save. */
  next?: string;
}

const { product = null, categories, next = '/pos/products' } = Astro.props;
const isEdit = Boolean(product);

const field =
  'w-full rounded-field border border-cream-300 bg-cream-50 px-3.5 py-2.5 text-sm text-ink placeholder-ink-faint focus:border-mint-mid focus:outline-none focus:ring-2 focus:ring-mint/40';
const label = 'mb-1.5 block text-micro font-bold uppercase tracking-eyebrow text-ink-muted';
const card = 'rounded-card border border-cream-300 bg-paper p-5 shadow-sm';
---

<form method="POST" action="/api/pos/product-save" class="grid gap-5 lg:grid-cols-3">
  <input type="hidden" name="next" value={next} />
  {isEdit && <input type="hidden" name="id" value={product!.id} />}

  <!-- Main column -->
  <div class="space-y-5 lg:col-span-2">
    <div class={card}>
      <h2 class="mb-4 font-display text-lg font-bold text-ink">Basics</h2>

      <div class="space-y-4">
        <div>
          <label class={label} for="name">Product name *</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            maxlength="140"
            value={product?.name ?? ''}
            placeholder="Merino Wool Yarn — Oatmeal"
            class={field}
          />
        </div>

        <div>
          <label class={label} for="slug">URL slug</label>
          <div class="flex items-center gap-2">
            <span class="shrink-0 font-mono text-xs text-ink-faint">/store/</span>
            <input
              id="slug"
              name="slug"
              type="text"
              maxlength="80"
              value={product?.slug ?? ''}
              placeholder="left blank, generated from the name"
              pattern="[a-z0-9\-]*"
              class={`${field} font-mono`}
            />
          </div>
          <p class="mt-1.5 text-xs text-ink-faint">
            Lowercase letters, numbers and hyphens. Changing this changes the product's public link.
          </p>
        </div>

        <div>
          <label class={label} for="description">Description *</label>
          <textarea
            id="description"
            name="description"
            required
            rows="6"
            placeholder="What it is, how it feels, what it is good for."
            class={field}>{product?.description ?? ''}</textarea>
        </div>

        <div>
          <label class={label} for="tags">Tags</label>
          <input
            id="tags"
            name="tags"
            type="text"
            value={product?.tags?.join(', ') ?? ''}
            placeholder="merino, wool, aran, undyed"
            class={field}
          />
          <p class="mt-1.5 text-xs text-ink-faint">Comma separated. Used by shop search.</p>
        </div>
      </div>
    </div>

    <!-- Images -->
    <div class={card}>
      <h2 class="mb-4 font-display text-lg font-bold text-ink">Images</h2>

      <label class={label} for="images">Image URLs — one per line</label>
      <textarea
        id="images"
        name="images"
        rows="4"
        placeholder="/assets/products/yarn-white-cotton.jpg"
        class={`${field} font-mono text-xs`}>{product?.images?.join('\n') ?? ''}</textarea>
      <p class="mt-1.5 text-xs text-ink-faint">
        The first one is the card thumbnail. Paths under <span class="font-mono">/public</span> work,
        as do full URLs.
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-cream-300 pt-4">
        <label
          for="image-upload"
          class="cursor-pointer rounded-pill border border-cream-300 bg-cream-100 px-4 py-2 text-xs font-bold text-ink transition-colors duration-fast ease-out hover:bg-cream-200"
        >
          Upload an image
        </label>
        <input id="image-upload" type="file" accept="image/*" multiple class="hidden" />
        <span id="upload-status" class="text-xs font-semibold text-ink-muted"></span>
      </div>

      <div id="image-preview" class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6"></div>
    </div>

    <!-- Craft details -->
    <div class={card}>
      <h2 class="mb-1 font-display text-lg font-bold text-ink">Craft details</h2>
      <p class="mb-4 text-xs text-ink-muted">
        Optional. Yarn weight and hook size appear together on the product card.
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class={label} for="yarn_weight">Yarn weight</label>
          <input
            id="yarn_weight"
            name="yarn_weight"
            type="text"
            list="yarn-weights"
            value={product?.yarn_weight ?? ''}
            placeholder="Aran"
            class={field}
          />
          <datalist id="yarn-weights">
            {['Lace', 'Fingering', 'Sport', 'DK', 'Worsted', 'Aran', 'Bulky', 'Super Bulky'].map(
              (w) => <option value={w} />,
            )}
          </datalist>
        </div>
        <div>
          <label class={label} for="hook_size">Hook size</label>
          <input
            id="hook_size"
            name="hook_size"
            type="text"
            value={product?.hook_size ?? ''}
            placeholder="5.0mm"
            class={field}
          />
        </div>
        <div>
          <label class={label} for="dimensions">Dimensions / quantity</label>
          <input
            id="dimensions"
            name="dimensions"
            type="text"
            value={product?.dimensions ?? ''}
            placeholder="100g · 180m per skein"
            class={field}
          />
        </div>
        <div>
          <label class={label} for="care_instructions">Care instructions</label>
          <input
            id="care_instructions"
            name="care_instructions"
            type="text"
            value={product?.care_instructions ?? ''}
            placeholder="Hand wash cold, lay flat to dry"
            class={field}
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Side column -->
  <div class="space-y-5">
    <div class={card}>
      <h2 class="mb-4 font-display text-lg font-bold text-ink">Visibility</h2>

      <div class="space-y-3">
        <label class="flex cursor-pointer items-start gap-3 rounded-field bg-cream-50 p-3">
          <input
            type="checkbox"
            name="is_active"
            value="true"
            checked={product ? product.is_active : true}
            class="mt-0.5 h-4 w-4 shrink-0 accent-[#00695C]"
          />
          <span>
            <span class="block text-sm font-bold text-ink">Live in the shop</span>
            <span class="block text-xs text-ink-muted">Uncheck to keep it as a draft.</span>
          </span>
        </label>

        <label class="flex cursor-pointer items-start gap-3 rounded-field bg-cream-50 p-3">
          <input
            type="checkbox"
            name="is_featured"
            value="true"
            checked={product?.is_featured ?? false}
            class="mt-0.5 h-4 w-4 shrink-0 accent-[#00695C]"
          />
          <span>
            <span class="block text-sm font-bold text-ink">Featured</span>
            <span class="block text-xs text-ink-muted">Sorts first on the shop page.</span>
          </span>
        </label>
      </div>
    </div>

    <div class={card}>
      <h2 class="mb-4 font-display text-lg font-bold text-ink">Category</h2>

      {
        categories.length === 0 ? (
          <p class="rounded-field bg-lemon-wash px-3 py-2.5 text-xs font-semibold text-lemon-deep">
            No categories yet —{' '}
            <a href="/pos/categories" class="underline">
              create one first
            </a>
            .
          </p>
        ) : (
          <>
            <label class={label} for="category_id">
              Sits under *
            </label>
            <select id="category_id" name="category_id" required class={field}>
              <option value="">Choose a category…</option>
              {categories.map((c) => (
                <option value={c.id} selected={product?.category_id === c.id}>
                  {c.name}
                  {c.is_active ? '' : ' (hidden)'}
                </option>
              ))}
            </select>
            <p class="mt-1.5 text-xs text-ink-faint">
              <a href="/pos/categories" class="font-semibold text-mint-deep hover:underline">
                Manage categories →
              </a>
            </p>
          </>
        )
      }
    </div>

    <div class={card}>
      <h2 class="mb-4 font-display text-lg font-bold text-ink">Price & stock</h2>

      <div class="space-y-4">
        <div>
          <label class={label} for="price">Price (USD) *</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-ink-faint">$</span>
            <input
              id="price"
              name="price"
              type="number"
              required
              min="0"
              step="0.01"
              value={product ? Number(product.price).toFixed(2) : ''}
              placeholder="14.00"
              class={`${field} pl-7`}
            />
          </div>
        </div>

        <div>
          <label class={label} for="compare_at_price">Compare-at price</label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-ink-faint">$</span>
            <input
              id="compare_at_price"
              name="compare_at_price"
              type="number"
              min="0"
              step="0.01"
              value={product?.compare_at_price ? Number(product.compare_at_price).toFixed(2) : ''}
              placeholder="18.00"
              class={`${field} pl-7`}
            />
          </div>
          <p class="mt-1.5 text-xs text-ink-faint">
            Set it higher than the price to show a discount badge.
          </p>
        </div>

        <div>
          <label class={label} for="stock">Stock on hand</label>
          <input
            id="stock"
            name="stock"
            type="number"
            min="0"
            step="1"
            value={product?.stock ?? 0}
            class={field}
          />
          <p class="mt-1.5 text-xs text-ink-faint">0 shows a “Sold out” badge; 1–3 shows “Only N left”.</p>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="sticky bottom-4 space-y-2">
      <button
        type="submit"
        class="w-full rounded-pill bg-btn-gradient py-3 text-sm font-bold text-ink shadow transition-all duration-fast ease-out hover:-translate-y-0.5 hover:brightness-105 active:scale-[.98]"
      >
        {isEdit ? 'Save changes' : 'Create product'}
      </button>
      <a
        href="/pos/products"
        class="block w-full rounded-pill border border-cream-300 bg-paper py-3 text-center text-sm font-bold text-ink-body transition-colors duration-fast ease-out hover:bg-cream-100"
      >
        Cancel
      </a>
    </div>
  </div>
</form>

<script>
  // Slug suggestion — only while the field is untouched and empty.
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const slugInput = document.getElementById('slug') as HTMLInputElement | null;
  let slugTouched = Boolean(slugInput?.value);

  slugInput?.addEventListener('input', () => {
    slugTouched = true;
  });

  nameInput?.addEventListener('input', () => {
    if (slugTouched || !slugInput) return;
    slugInput.value = nameInput.value
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80);
  });

  // Image list preview + uploader.
  const imagesField = document.getElementById('images') as HTMLTextAreaElement | null;
  const preview = document.getElementById('image-preview');
  const fileInput = document.getElementById('image-upload') as HTMLInputElement | null;
  const status = document.getElementById('upload-status');

  function urls(): string[] {
    return (imagesField?.value ?? '')
      .split('\n')
      .map((l) => l.trim())
      .filter(Boolean);
  }

  function renderPreview() {
    if (!preview) return;
    preview.innerHTML = '';
    urls().forEach((url, i) => {
      const wrap = document.createElement('div');
      wrap.className =
        'relative aspect-square overflow-hidden rounded-field border border-cream-300 bg-cream-100';
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.loading = 'lazy';
      img.className = 'h-full w-full object-cover';
      wrap.appendChild(img);
      if (i === 0) {
        const badge = document.createElement('span');
        badge.textContent = 'Main';
        badge.className =
          'absolute left-1 top-1 rounded-pill bg-mint px-1.5 py-0.5 text-[9px] font-bold uppercase text-ink';
        wrap.appendChild(badge);
      }
      preview.appendChild(wrap);
    });
  }

  imagesField?.addEventListener('input', renderPreview);
  renderPreview();

  fileInput?.addEventListener('change', async () => {
    const files = Array.from(fileInput.files ?? []);
    if (!files.length || !imagesField) return;

    for (const [i, file] of files.entries()) {
      if (status) status.textContent = `Uploading ${i + 1} of ${files.length}…`;
      const body = new FormData();
      body.append('file', file);

      try {
        const res = await fetch('/api/pos/upload', { method: 'POST', body });
        const json = await res.json();
        if (!res.ok || !json.url) throw new Error(json.error ?? 'Upload failed');
        const existing = imagesField.value.trim();
        imagesField.value = existing ? `${existing}\n${json.url}` : json.url;
        renderPreview();
      } catch (err) {
        if (status) status.textContent = err instanceof Error ? err.message : 'Upload failed';
        fileInput.value = '';
        return;
      }
    }

    if (status) status.textContent = `Added ${files.length} image${files.length > 1 ? 's' : ''}.`;
    fileInput.value = '';
  });
</script>
